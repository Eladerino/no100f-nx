diff --git a/switch/runtime/horizon_pthread.c b/switch/runtime/horizon_pthread.c
new file mode 100644
index 0000000..2e26c2a
--- /dev/null
+++ b/switch/runtime/horizon_pthread.c
@@ -0,0 +1,259 @@
+// Adapted from SwitchWaker (MIT, switch/native/source/thread_wrap.c at 92307ff); see switch/THIRD_PARTY.md.
+// Every pthread (and so every std::thread) of the NRO, which links with -Wl,--wrap=pthread_create
+// (switch/cmake/SpmSwitch.cmake):
+//
+// - a stack of at least 4 MiB, page-aligned: libnx gives a pthread 128 KiB by default, which Tint
+//   (Dawn's shader compiler) overflows. Boot 6 crashed that way on Aurora's pipeline compile worker
+//   right after it was handed the 1156 seeded pipelines: a write one page below a thread's stack.
+//   libnx also refuses a size that is not a multiple of 4 KiB.
+// - the application cores: libnx creates pthreads on the process's default core with priority 0x3B,
+//   below the main thread's 0x2C, so every helper would share core 0 with the guest scheduler and run
+//   only when it waits (Horizon does not time-slice). Each new thread prefers core 1 or 2 in turn,
+//   may run on any of the process's cores among 0-2, and gets the main thread's priority.
+//
+// - detached threads: libnx has no __syscall_thread_detach, so newlib's pthread_detach fails with
+//   ENOSYS, std::thread::detach() throws, and the temporary std::thread's destructor, still joinable,
+//   calls std::terminate(). Boot 8: the runtime's stall watchdog (hle/vi.cpp StartStallWatchdogOnce,
+//   std::thread(...).detach()) ended the game at its first frame that way. pthread_detach hands
+//   the thread to a reaper thread, which joins it once its handle signals that it ended (its stack
+//   and kernel thread are freed then).
+//
+// SwitchWaker's version also keeps a thread registry for its performance lines; not needed yet.
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <switch.h>
+
+#define MINIMUM_STACK_SIZE (4u * 1024u * 1024u)
+#define THREAD_PRIORITY 0x2C
+
+int __real_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg);
+int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg);
+int __wrap_pthread_detach(pthread_t thread);
+
+static atomic_int g_next_core = 1;
+
+// guestcore (dk_diag.txt, test build spec B2): with it on, helper threads are kept off the
+// guest's core 0 entirely. An unpinned thread's mask today is every application core, so a
+// pipeline compile (Tint holds a core for hundreds of ms on a cold pipeline) can land on the
+// guest core and stall it; KartPadNX calls keeping compilers off the guest core its decisive
+// fix. This file runs before the renderer's diag_init (threads start at process start), so it
+// reads dk_diag.txt itself, once, on first use. What is bought is only "never on core 0":
+// with three application cores the helpers share cores 1 and 2 with the pinned GX threads.
+static atomic_int g_guestcore = -1; // -1 unknown, 0 off, 1 on
+
+static int guestcore_enabled(void)
+{
+    int cached = atomic_load(&g_guestcore);
+    if (cached >= 0)
+        return cached;
+    int on = 0;
+    FILE* f = fopen("/switch/spm-nx/UserData/dk_diag.txt", "r");
+    if (f != NULL) {
+        char line[256];
+        while (fgets(line, sizeof line, f) != NULL) {
+            const char* p = line;
+            while (*p == ' ' || *p == '\t') p++;
+            const char* key = p;
+            while ((*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') || *p == '_') p++;
+            if ((size_t)(p - key) != 9 || strncmp(key, "guestcore", 9) != 0)
+                continue;
+            while (*p == ' ' || *p == '\t') p++;
+            if (*p == '\0' || *p == '\n' || *p == '\r') { // a bare key means on, as in device.cpp
+                on = 1;
+                continue;
+            }
+            if (*p != '=')
+                continue;
+            p++;
+            while (*p == ' ' || *p == '\t') p++;
+            on = !(p[0] == '0' || strncasecmp(p, "off", 3) == 0 || strncasecmp(p, "false", 5) == 0);
+        }
+        fclose(f);
+    }
+    atomic_store(&g_guestcore, on);
+    return on;
+}
+
+static u32 application_core_mask(void);
+
+// The next preferred core for a helper thread with guestcore on: the application cores minus
+// core 0, dealt from the highest down (2, then 1), KartPadNX's compiler_core shape. -1 when
+// nothing is left (a one-core process), meaning keep the normal dealing.
+static int guestcore_next_core(void)
+{
+    static atomic_int next = 0;
+    const u32 mask = application_core_mask() & ~1u;
+    int cores[3];
+    int n = 0;
+    for (int c = 2; c >= 0; c--)
+        if (mask & (1u << c))
+            cores[n++] = c;
+    if (n == 0)
+        return -1;
+    return cores[atomic_fetch_add(&next, 1) % n];
+}
+
+struct Trampoline {
+    void* (*start)(void*);
+    void* arg;
+    int core;
+};
+
+static u32 application_core_mask(void)
+{
+    static u32 mask;
+    if (mask == 0) {
+        u64 process_mask = 0;
+        if (R_FAILED(svcGetInfo(&process_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)))
+            process_mask = 0x7;
+        mask = (u32)process_mask & 0x7;
+        if (mask == 0)
+            mask = 0x1;
+    }
+    return mask;
+}
+
+static void* trampoline(void* raw)
+{
+    struct Trampoline t = *(struct Trampoline*)raw;
+    free(raw);
+    u32 mask = application_core_mask();
+    if (guestcore_enabled()) {
+        const u32 no_guest = mask & ~1u;
+        if (no_guest != 0)
+            mask = no_guest;
+    }
+    int core = t.core;
+    if ((mask & (1u << core)) == 0)
+        core = __builtin_ctz(mask);
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, mask);
+    svcSetThreadPriority(CUR_THREAD_HANDLE, THREAD_PRIORITY);
+    return t.start(t.arg);
+}
+
+int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg)
+{
+    pthread_attr_t sized;
+    size_t requested = 0;
+    if (attr != NULL) {
+        sized = *attr;
+        if (pthread_attr_getstacksize(attr, &requested) != 0)
+            requested = 0;
+    } else {
+        pthread_attr_init(&sized);
+    }
+    size_t size = requested < MINIMUM_STACK_SIZE ? MINIMUM_STACK_SIZE : requested;
+    size = (size + 0xFFF) & ~(size_t)0xFFF;
+    pthread_attr_setstacksize(&sized, size);
+
+    struct Trampoline* t = malloc(sizeof *t);
+    if (t == NULL) {
+        const int result = __real_pthread_create(thread, &sized, start, arg);
+        if (attr == NULL)
+            pthread_attr_destroy(&sized);
+        return result;
+    }
+    t->start = start;
+    t->arg = arg;
+    const int guest_free = guestcore_enabled() ? guestcore_next_core() : -1;
+    t->core = guest_free >= 0 ? guest_free : 1 + (atomic_fetch_add(&g_next_core, 1) - 1) % 2; // 1, 2, 1, 2...
+    const int result = __real_pthread_create(thread, &sized, trampoline, t);
+    if (result != 0)
+        free(t);
+    if (attr == NULL)
+        pthread_attr_destroy(&sized);
+    return result;
+}
+
+// ---- reaper of detached threads -------------------------------------------------------------------
+// newlib's pthread_t is libnx's struct __pthread_t*, whose first member is the libnx Thread.
+#define MAX_REAP 64 // svcWaitSynchronization's limit
+
+static Mutex g_reap_lock;
+static pthread_t g_reap[MAX_REAP];
+static int g_reap_count;
+static atomic_int g_reaper_started;
+
+static Handle thread_handle(pthread_t t)
+{
+    return ((const Thread*)t)->handle;
+}
+
+static void reap_remove(pthread_t t)
+{
+    mutexLock(&g_reap_lock);
+    for (int i = 0; i < g_reap_count; i++) {
+        if (g_reap[i] == t) {
+            g_reap[i] = g_reap[--g_reap_count];
+            break;
+        }
+    }
+    mutexUnlock(&g_reap_lock);
+}
+
+static void* reaper(void* unused)
+{
+    (void)unused;
+    for (;;) {
+        Handle handles[MAX_REAP];
+        pthread_t threads[MAX_REAP];
+        mutexLock(&g_reap_lock);
+        const int n = g_reap_count;
+        for (int i = 0; i < n; i++) {
+            threads[i] = g_reap[i];
+            handles[i] = thread_handle(g_reap[i]);
+        }
+        mutexUnlock(&g_reap_lock);
+        if (n == 0) {
+            svcSleepThread(100000000ull);
+            continue;
+        }
+        s32 index = -1;
+        // 100 ms: threads detached meanwhile are picked up at the next round
+        const Result rc = svcWaitSynchronization(&index, handles, n, 100000000ull);
+        if (R_VALUE(rc) == KERNELRESULT(InvalidHandle)) {
+            // not a thread any more (should not happen): drop the ones that are not, keep the others
+            for (int i = 0; i < n; i++) {
+                s32 one = -1;
+                if (R_VALUE(svcWaitSynchronization(&one, &handles[i], 1, 0)) == KERNELRESULT(InvalidHandle))
+                    reap_remove(threads[i]);
+            }
+            continue;
+        }
+        if (R_FAILED(rc) || index < 0 || index >= n)
+            continue;
+        reap_remove(threads[index]);
+        pthread_join(threads[index], NULL); // it has ended: frees its stack and closes its handle
+    }
+    return NULL;
+}
+
+int __wrap_pthread_detach(pthread_t thread)
+{
+    if (atomic_exchange(&g_reaper_started, 1) == 0) {
+        pthread_t r;
+        if (__wrap_pthread_create(&r, NULL, reaper, NULL) != 0)
+            fprintf(stderr, "[switch] the reaper of detached threads could not start\n");
+    }
+    mutexLock(&g_reap_lock);
+    bool listed = false;
+    for (int i = 0; i < g_reap_count; i++)
+        listed = listed || g_reap[i] == thread;
+    const bool full = !listed && g_reap_count >= MAX_REAP;
+    if (!listed && !full)
+        g_reap[g_reap_count++] = thread;
+    mutexUnlock(&g_reap_lock);
+    if (full) {
+        static int warned;
+        if (!warned++)
+            fprintf(stderr, "[switch] %d detached threads already wait to be joined: more are left unjoined\n",
+                    MAX_REAP);
+    }
+    // Detached either way: the caller (std::thread::detach) must not see an error.
+    return 0;
+}
diff --git a/switch/runtime/horizon_tls.c b/switch/runtime/horizon_tls.c
new file mode 100644
index 0000000..9bfd384
--- /dev/null
+++ b/switch/runtime/horizon_tls.c
@@ -0,0 +1,116 @@
+// Native thread-local storage for the clang-compiled code (switch/cmake/clang-launcher.sh).
+//
+// libnx gives every thread an ELF TLS block, and devkitA64's GCC reaches it through a soft thread
+// pointer: a call to libnx's __aarch64_read_tp (mrs tpidrro_el0, then a load of the thread's
+// tls_tp). clang has no soft thread pointer for AArch64, so the clang half of the NRO (the runtime,
+// Aurora and the translated game) used to compile with -femulated-tls instead, and every
+// thread_local access became a call to libgcc's __emutls_get_address, then pthread_getspecific,
+// then libnx's threadTlsGet: about 35 instructions and three calls, and it turned leaf functions
+// into ones with a stack frame. The runtime reads thread_locals on hot paths it tuned for the
+// one-instruction TLS of the desktop: every guest-to-guest call (g_currentCpuContext), every
+// single-precision float operation (g_mkwNiFlushThreshold) and every indirect call (the dispatch
+// memos and g_currentTranslatedExecutionAddress).
+//
+// clang now reads the thread pointer from TPIDR_EL0 (-mtp=el0), which Horizon keeps per thread
+// (it is in every thread's saved context, ThreadContext::tpidr) and libnx leaves at zero. This file
+// makes TPIDR_EL0 hold the same value __aarch64_read_tp returns, so both compilers find each
+// thread_local at the same address (the linker's TP-relative offsets are the same for both):
+// - the main thread: spm_switch_tls_init_main_thread(), the first thing userAppInit() does, which
+//   libnx calls before the static constructors and main() (spm_switch_tls_check_main_thread() checks
+//   it once stderr goes to the log);
+// - every other thread: the NRO links with -Wl,--wrap=threadCreate (switch/cmake/SpmSwitch.cmake),
+//   and the wrapper starts the thread in a trampoline that sets TPIDR_EL0 before the thread's own
+//   entry runs. pthread_create (and so std::thread) creates its threads through threadCreate, and
+//   so does everything else in the NRO.
+//
+// A probe with an initial value checks the arrangement on every thread the wrapper starts and on
+// the main thread: a wrong thread pointer reads some other memory than the probe's initial value,
+// and the process stops with a message in the log instead of running on with corrupt thread
+// locals.
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <switch.h>
+
+// libnx: the soft thread pointer GCC's code calls (readtp.o).
+void* __aarch64_read_tp(void);
+
+Result __real_threadCreate(Thread* t, ThreadFunc entry, void* arg, void* stack_mem, size_t stack_sz, int prio,
+                           int cpuid);
+Result __wrap_threadCreate(Thread* t, ThreadFunc entry, void* arg, void* stack_mem, size_t stack_sz, int prio,
+                           int cpuid);
+void spm_switch_tls_init_main_thread(void);
+void spm_switch_tls_check_main_thread(void);
+
+#define TLS_PROBE_VALUE 0x5EED7150u
+static _Thread_local volatile uint32_t g_tls_probe = TLS_PROBE_VALUE;
+
+static inline void set_thread_pointer(void)
+{
+    __asm__ volatile("msr tpidr_el0, %0" ::"r"(__aarch64_read_tp()) : "memory");
+}
+
+static void check_probe(const char* where)
+{
+    if (g_tls_probe == TLS_PROBE_VALUE)
+        return;
+    fprintf(stderr,
+            "[switch] FATAL: thread-local storage is misplaced on %s (probe read 0x%08x, expected 0x%08x, "
+            "tpidr_el0 %p, libnx thread pointer %p)\n",
+            where, (unsigned)g_tls_probe, TLS_PROBE_VALUE, __builtin_thread_pointer(), __aarch64_read_tp());
+    fflush(stderr);
+    abort();
+}
+
+void spm_switch_tls_init_main_thread(void)
+{
+    set_thread_pointer();
+}
+
+void spm_switch_tls_check_main_thread(void)
+{
+    check_probe("the main thread");
+}
+
+struct TlsTrampoline {
+    ThreadFunc entry;
+    void* arg;
+};
+
+static void tls_trampoline(void* raw)
+{
+    set_thread_pointer();
+    check_probe("a new thread");
+    const struct TlsTrampoline t = *(const struct TlsTrampoline*)raw;
+    free(raw);
+    t.entry(t.arg);
+}
+
+Result __wrap_threadCreate(Thread* t, ThreadFunc entry, void* arg, void* stack_mem, size_t stack_sz, int prio,
+                           int cpuid)
+{
+    struct TlsTrampoline* tramp = malloc(sizeof *tramp);
+    if (tramp == NULL)
+        return MAKERESULT(Module_Libnx, LibnxError_OutOfMemory);
+    tramp->entry = entry;
+    tramp->arg = arg;
+    const Result rc = __real_threadCreate(t, tls_trampoline, tramp, stack_mem, stack_sz, prio, cpuid);
+    if (R_FAILED(rc))
+        free(tramp);
+    return rc;
+}
+
+// Nothing in the NRO may still use emulated TLS: an object compiled with -femulated-tls keeps its own
+// copy of each thread_local it touches, apart from the native one the rest of the program uses (a
+// stale object from a build before the switch to native TLS, say). This definition takes the place
+// of libgcc's, so such an object stops the game at its first thread_local access with this message
+// instead of running with two copies of the guest CPU context pointer.
+void* __emutls_get_address(void* control)
+{
+    fprintf(stderr,
+            "[switch] FATAL: an object in this build still uses emulated thread-local storage (control %p): "
+            "rebuild from a clean build folder\n",
+            control);
+    fflush(stderr);
+    abort();
+}
diff --git a/switch/runtime/horizon_unistd.c b/switch/runtime/horizon_unistd.c
new file mode 100644
index 0000000..74c8541
--- /dev/null
+++ b/switch/runtime/horizon_unistd.c
@@ -0,0 +1,59 @@
+// POSIX calls newlib declares but libnx does not provide, or provides only as ENOSYS stubs.
+#include <errno.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// Horizon has no pipes. The runtime's process transcript (main.cpp) pipes stdout and stderr through
+// a thread into console.log; when pipe() fails it puts the streams back and carries on, so stderr
+// keeps going to UserData/Logs/stderr.log (source/spm_switch_init.cpp).
+int pipe(int fds[2])
+{
+    (void)fds;
+    errno = ENOSYS;
+    return -1;
+}
+
+// The SD card has no permission bits, and libnx's fsdev chmod and fchmod fail with ENOSYS. libstdc++'s
+// std::filesystem::copy_file calls fchmod on the new file to give it the source's mode and fails when
+// that does, so every copy failed: the managed NAND's first-run WC24 files (nand_path.h) could not be
+// created and the game stopped in NANDInit. Changing nothing is the right answer here, so these
+// report success for a file or descriptor that exists.
+int fchmod(int fd, mode_t mode)
+{
+    (void)mode;
+    struct stat st;
+    return fstat(fd, &st);
+}
+
+int chmod(const char* path, mode_t mode)
+{
+    (void)mode;
+    struct stat st;
+    return stat(path, &st);
+}
+
+// POSIX rename replaces an existing destination; Horizon's file system refuses it (the path already
+// exists), so libnx's rename fails. The runtime saves through a temporary file renamed over the old
+// one (hle/storage/nand_async.cpp AtomicReplaceHostFile), and NANDCreate makes the save file before
+// the first write, so every save failed with "rename(... .nandsafe.tmp -> ...) failed" (boot 9). The
+// NRO links with -Wl,--wrap=rename (cmake/SpmSwitch.cmake): when the plain rename fails and both
+// paths are regular files, the old destination is removed and the rename tried again. That is not
+// atomic: a kill between the two steps leaves only the temporary file, which holds the new data.
+int __real_rename(const char* from, const char* to);
+
+int __wrap_rename(const char* from, const char* to)
+{
+    if (__real_rename(from, to) == 0)
+        return 0;
+    const int err = errno;
+    struct stat source;
+    struct stat target;
+    if (stat(from, &source) != 0 || !S_ISREG(source.st_mode) || stat(to, &target) != 0 ||
+        !S_ISREG(target.st_mode)) {
+        errno = err;
+        return -1;
+    }
+    if (unlink(to) != 0)
+        return -1;
+    return __real_rename(from, to);
+}
diff --git a/switch/scripts/Containerfile b/switch/scripts/Containerfile
new file mode 100644
index 0000000..6bbaad8
--- /dev/null
+++ b/switch/scripts/Containerfile
@@ -0,0 +1,15 @@
+# Build image for the Switch NRO (switch/scripts/build-switch.sh): devkitA64 at the digest SwitchWaker
+# pins (GCC 15.2, libnx 4.12, deko3d 0.5, uam 1.1), plus clang 19 for the WiiCompiled sources and a
+# CMake new enough for the runtime (3.25+). llvm 19 rides along for llvm-profdata-19 only: the
+# pgo-use variant merges the capture build's raw profiles with it, version-locked to clang 19.
+FROM docker.io/devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282
+
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends \
+        cmake=3.31.6-2~bpo12+1 \
+        ninja-build=1.11.1-2~deb12u1 \
+        pkg-config=1.8.1-1 \
+        clang-19=1:19.1.7-3~deb12u1 \
+        llvm-19=1:19.1.7-3~deb12u1 \
+        rsync \
+    && rm -rf /var/lib/apt/lists/*
diff --git a/switch/scripts/build-switch.sh b/switch/scripts/build-switch.sh
new file mode 100755
index 0000000..02ee570
--- /dev/null
+++ b/switch/scripts/build-switch.sh
@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+# Switch build of FrightWorks (no100f-nx). Run in WSL (or Linux) with podman or docker, after
+# tools\build-no100f.ps1 has translated the game on Windows: this reuses that translation
+# (wiicompiled\generated) and only compiles it, here for Horizon inside switch/scripts/Containerfile.
+# Adapted from spm-nx switch/scripts/build-switch.sh (12ec5e7), minus its variants and patch passes.
+#   bash switch/scripts/build-switch.sh [--jobs N] [--audit] [--out DIR|none] [--game]
+# --audit compiles only the runtime's sources for the Switch (no game, no Dawn, no Aurora): the quick
+#   check after an upstream merge. It needs no translation.
+# --out DIR stages the NRO and its companion files, laid out like the SD card, in DIR/switch/no100f-nx/.
+#   DIR defaults to Downloads\no100f-nx-sd in your Windows profile under WSL; --out none skips it.
+# --game also stages your extracted disc (Disc/DATA) as DIR/switch/no100f-nx/game. It is about 1.4 GB
+#   and the card only needs it once. It is your own disc's data: it stays on your PC and your card.
+# Sources are copied to ~/no100f-switch first (the container mounts that, not the Windows drive, which
+# is much slower through WSL). Output: ~/no100f-switch/build/no100f-nx.nro
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+jobs=6   # translated shards need ~1 GB each (spm-nx's figure; a guess for FrightWorks)
+audit=0
+out=auto
+game=0
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --jobs) jobs=$2; shift ;;
+        --audit) audit=1 ;;
+        --out) out=$2; shift ;;
+        --game) game=1 ;;
+        *) echo "unknown argument $1" >&2; exit 1 ;;
+    esac
+    shift
+done
+
+engine=$(command -v podman || command -v docker || true)
+[[ -n $engine ]] || { echo "needs podman or docker" >&2; exit 1; }
+image=no100f-nx-build
+"$engine" build -t "$image" -f "$root/switch/scripts/Containerfile" "$root/switch/scripts"
+
+work=$HOME/no100f-switch
+mkdir -p "$work/wiicompiled"
+echo "copying sources to $work"
+rsync -a --delete --exclude probe "$root/switch/" "$work/switch/"
+rsync -a --delete "$root/wiicompiled/runtime/" "$work/wiicompiled/runtime/"
+rsync -a --delete "$root/wiicompiled/aurora-main/" "$work/wiicompiled/aurora-main/"
+rsync -a --delete "$root/wiicompiled/projects/" "$work/wiicompiled/projects/"
+if [[ $audit == 0 ]]; then
+    src=$root/wiicompiled
+    [[ -f $src/generated/build_shards/shards.cmake && -f $src/generated/RuntimeConfig.h ]] ||
+        { echo "no translated game in $src/generated: run tools\\build-no100f.ps1 on Windows first" >&2; exit 1; }
+    rsync -a --delete --exclude functions "$src/generated/" "$work/wiicompiled/generated/"
+    # The translator wrote absolute Windows paths into the shard list and the data blobs' .incbin
+    # lines; inside the container the tree is at /work.
+    if command -v wslpath >/dev/null; then
+        win=$(wslpath -m "$src")
+        grep -rlF "$win" "$work/wiicompiled/generated" --include='*.cmake' --include='*.S' --include='*.cpp' --include='*.h' |
+            xargs -r sed -i "s|$win|/work/wiicompiled|g"
+        # A path written with backslashes would slip past the rewrite above; say so instead of
+        # letting the build fail later on a missing file.
+        if grep -rqiE '[a-z]:\\\\' "$work/wiicompiled/generated/build_shards/shards.cmake"; then
+            echo "WARNING: shards.cmake still holds a Windows path with backslashes; the build may not find those files" >&2
+        fi
+    fi
+fi
+
+# Separate build folders: CMake caches FW_SWITCH_AUDIT, so a full build in the audit's folder would
+# still skip Dawn and Aurora.
+products=ON; target=WiiCompiled_nro; build=build; extra=(-DFW_SWITCH_AUDIT=OFF)
+if [[ $audit == 1 ]]; then
+    products=OFF; target=recomp_switch_audit; build=build-audit; extra=(-DFW_SWITCH_AUDIT=ON)
+fi
+
+"$engine" run --rm -v "$work:/work" -w /work "$image" bash -c "
+    set -e
+    cmake -S wiicompiled/runtime -B $build -G Ninja \
+        -DCMAKE_TOOLCHAIN_FILE=/opt/devkitpro/cmake/Switch.cmake -DCMAKE_BUILD_TYPE=Release \
+        -DRECOMP_BUILD_PRODUCTS=$products -DRECOMP_TRANSLATED_COMPILE_JOBS=$jobs ${extra[*]}
+    cmake --build $build --target $target --parallel $jobs -- -k 0
+" 2>&1 | tee "$work/$build.log"
+
+if [[ $audit == 1 ]]; then
+    echo "DONE: runtime compiles for Horizon"
+    exit 0
+fi
+
+nro=$work/$build/no100f-nx.nro
+[[ -f $nro ]] || { echo "no NRO at $nro: see $work/$build.log" >&2; exit 1; }
+echo "DONE: $nro"
+if [[ $out == auto ]]; then
+    out=
+    if command -v wslpath >/dev/null && command -v cmd.exe >/dev/null; then
+        profile=$(cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
+        [[ -n $profile ]] && out=$(wslpath -u "$profile")/Downloads/no100f-nx-sd
+    fi
+fi
+if [[ -n $out && $out != none ]]; then
+    dest=$out/switch/no100f-nx
+    mkdir -p "$dest"
+    cp "$nro" "$dest/"
+    # The runtime's companion files (PublicProducts.cmake copies them beside the executable).
+    for f in dsp_coef.bin cacert.pem initial_pipeline_cache.db; do
+        [[ -f $work/$build/$f ]] && cp "$work/$build/$f" "$dest/"
+    done
+    [[ -d $work/$build/wii_bootstrap ]] && cp -r "$work/$build/wii_bootstrap" "$dest/"
+    # The license pack travels with the binary.
+    mkdir -p "$dest/licenses"
+    cp "$root/LICENSE" "$root/wiicompiled/THIRD-PARTY-NOTICES.md" "$root/switch/THIRD_PARTY.md" "$dest/licenses/"
+    cp "$root"/switch/licenses/*.txt "$dest/licenses/"
+    if [[ $game == 1 ]]; then
+        [[ -f $root/Disc/DATA/sys/boot.bin ]] || { echo "--game: no extracted disc at $root/Disc/DATA" >&2; exit 1; }
+        echo "staging your extracted disc as $dest/game (one time; about 1.4 GB)"
+        rsync -a --delete "$root/Disc/DATA/" "$dest/game/"
+    fi
+    echo "COPIED to $dest ($(date -r "$dest/no100f-nx.nro" '+%Y-%m-%d %H:%M'))"
+    echo "copy it onto the SD card, merging (never replace the no100f-nx folder: its UserData holds saves and logs),"
+    echo "with the disc in sdmc:/switch/no100f-nx/game (files/ and sys/), then launch with title takeover"
+else
+    echo "copy $nro to sdmc:/switch/no100f-nx/, then launch with title takeover"
+fi
diff --git a/switch/sdl3_shim/PATCHES.md b/switch/sdl3_shim/PATCHES.md
new file mode 100644
index 0000000..b823a8a
--- /dev/null
+++ b/switch/sdl3_shim/PATCHES.md
@@ -0,0 +1,23 @@
+# Local changes to SwitchWaker's SDL 3 shim
+
+Taken from SwitchWaker `switch/aurora/sdl3_shim/` at `92307ff`. SwitchWaker's shim covers the SDL
+calls Aurora makes; WiiCompiled's runtime makes more, so this copy adds them. Changes, by file:
+
+- `sdl3_shim_gamepad.c`: opening the pad is reference counted (`g_open`) so the runtime's gamepad
+  and joystick views of the same controller can open and close it independently. New
+  `sdl3_shim_gamepad_connected()` and `sdl3_shim_gamepad_if_open()` (declared in `sdl3_shim.h`)
+  let the joystick API in `sdl3_shim_wiicompiled.c` reuse it. A long press of Minus (500 ms)
+  queues synthetic F10 key events so the runtime's settings menu can open on a console with
+  no keyboard; presses are held back until they prove short or long, so a short press still
+  reaches the game as an ordinary brief press and a long one is swallowed.
+- `sdl3_shim_audio.c`: a per-stream gain (starts at 1.0, applied when samples are queued) and
+  `SDL_SetAudioStreamGain`, which the runtime's volume setting calls.
+- `sdl3_shim_events.c`: `SDL_PumpEvents`, a public wrapper over the shim's existing pump.
+- `sdl3_shim_wiicompiled.c` (new, this fork's code): the 37 remaining calls WiiCompiled makes. The
+  joystick API as views of the one gamepad, `SDL_GetGamepads`/`SDL_GetJoysticks`, the
+  name/string lookups, a fixed 1280x720 at 60 Hz display mode, cursor and scancode stubs,
+  `SDL_GetPlatform`, `SDL_GetTicksNS` (from the CPU tick), the log setters and `SDL_strstr`.
+
+Checked against the 3.4.4 headers: every `SDL_` symbol the runtime and Aurora reference resolves to
+exactly one definition here, except the Android-only calls (compiled out on the Switch) and
+`SDL_main` (libnx supplies `main`).
diff --git a/switch/sdl3_shim/sdl3_shim.h b/switch/sdl3_shim/sdl3_shim.h
new file mode 100644
index 0000000..4d990f6
--- /dev/null
+++ b/switch/sdl3_shim/sdl3_shim.h
@@ -0,0 +1,22 @@
+// Internal interfaces between the parts of the Switch SDL 3 shim.
+#pragma once
+
+#include <SDL3/SDL.h>
+
+#define SDL3_SHIM_WIDTH 1280
+#define SDL3_SHIM_HEIGHT 720
+
+void sdl3_shim_set_error(const char* format, ...);
+
+// Gamepad: configures libnx input once; pump samples it and queues
+// SDL_EVENT_GAMEPAD_ADDED/REMOVED when the controller appears or goes.
+void sdl3_shim_gamepad_init(void);
+void sdl3_shim_gamepad_pump(void);
+// The one gamepad's state for the joystick-style calls (sdl3_shim_wiicompiled.c).
+bool sdl3_shim_gamepad_connected(void);
+SDL_Gamepad* sdl3_shim_gamepad_if_open(void);
+
+// Queues an event for SDL_PollEvent after running the event watches.
+void sdl3_shim_queue_event(const SDL_Event* event);
+// Queues SDL_EVENT_QUIT once, from any thread (the applet exit request).
+void sdl3_shim_request_quit(void);
diff --git a/switch/sdl3_shim/sdl3_shim_absent.c b/switch/sdl3_shim/sdl3_shim_absent.c
new file mode 100644
index 0000000..e96cff1
--- /dev/null
+++ b/switch/sdl3_shim/sdl3_shim_absent.c
@@ -0,0 +1,64 @@
+// SDL 3 devices the Switch build does not have: haptic devices, standalone
+// sensors, keyboard and mouse. Each reports absence the way SDL does when the
+// device is missing.
+#include <SDL3/SDL.h>
+#include <stdlib.h>
+
+#include "sdl3_shim.h"
+
+SDL_HapticID* SDL_GetHaptics(int* count) {
+    if (count != NULL)
+        *count = 0;
+    return calloc(1, sizeof(SDL_HapticID));
+}
+const char* SDL_GetHapticNameForID(SDL_HapticID instance_id) { (void)instance_id; return NULL; }
+SDL_Haptic* SDL_OpenHaptic(SDL_HapticID instance_id) { (void)instance_id; return NULL; }
