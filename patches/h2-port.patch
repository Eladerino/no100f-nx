diff --git a/switch/include/cryptopp/osrng.h b/switch/include/cryptopp/osrng.h
new file mode 100644
index 0000000..feb4c27
--- /dev/null
+++ b/switch/include/cryptopp/osrng.h
@@ -0,0 +1,33 @@
+// Wraps Crypto++'s osrng.h on the Switch build (switch/include comes before runtime/third_party on
+// the include path, so <cryptopp/osrng.h> lands here first and #include_next reaches the real one).
+//
+// Crypto++ only defines AutoSeededRandomPool where it knows the OS entropy source (/dev/urandom on
+// Unix, BCryptGenRandom on Windows); Horizon is neither, so the real header defines nothing. The
+// runtime needs it in one place: the nonce for signing Wii ES data (include/wii_es_crypto.h). This
+// supplies a drop-in with the same name, backed by libnx's randomGet() (a CSPRNG the kernel seeds).
+#pragma once
+
+#include_next <cryptopp/osrng.h>
+
+#if defined(__SWITCH__) && !defined(OS_RNG_AVAILABLE)
+
+#include <cryptopp/cryptlib.h>
+#include <string>
+
+extern "C" void randomGet(void* buf, size_t len);
+
+NAMESPACE_BEGIN(CryptoPP)
+
+class AutoSeededRandomPool : public RandomNumberGenerator {
+public:
+    explicit AutoSeededRandomPool(bool blocking = false, unsigned int seedSize = 32) {
+        (void)blocking;
+        (void)seedSize;
+    }
+    void GenerateBlock(byte* output, size_t size) override { randomGet(output, size); }
+    std::string AlgorithmName() const override { return "HorizonRandom"; }
+};
+
+NAMESPACE_END
+
+#endif
diff --git a/switch/include/ifaddrs.h b/switch/include/ifaddrs.h
new file mode 100644
index 0000000..e69b004
--- /dev/null
+++ b/switch/include/ifaddrs.h
@@ -0,0 +1,30 @@
+// ifaddrs.h for Horizon (Switch build only). Netplay (runtime/src/netplay/net_socket.cpp) lists the
+// host's interface addresses to show them in the lobby. libnx has no getifaddrs; this one reports
+// ENOSYS (switch/runtime/horizon_net.c), so the lobby simply has no local address to show. Netplay
+// over libnx's BSD sockets otherwise compiles as on Linux.
+#pragma once
+
+#include <sys/socket.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ifaddrs {
+    struct ifaddrs* ifa_next;
+    char* ifa_name;
+    unsigned int ifa_flags;
+    struct sockaddr* ifa_addr;
+    struct sockaddr* ifa_netmask;
+    struct sockaddr* ifa_dstaddr;
+    void* ifa_data;
+};
+// glibc spells the broadcast address as an alias of the point-to-point one, the same way.
+#define ifa_broadaddr ifa_dstaddr
+
+int getifaddrs(struct ifaddrs** ifap);
+void freeifaddrs(struct ifaddrs* ifa);
+
+#ifdef __cplusplus
+}
+#endif
