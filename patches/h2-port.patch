+                "${DAWN_DYNAMIC_LIB_PATCH_OUTPUT}${DAWN_DYNAMIC_LIB_PATCH_ERROR}")
+        endif()
+    endif()
+
+    set(DAWN_SYSTEM_UTILS_SOURCE
