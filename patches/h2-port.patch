+// The flat guest window's base, RECOMP_FLAT_GUEST_BASE on Switch (wiicompiled/runtime/include/
+// guest_flat_memory.h). Every C++ file sees it as `uint8_t* const`, so translated code can keep it
+// in a register for a whole function; this C file is the only place it is defined, and written,
+// non-const. guest_flat_memory_horizon.cpp sets it once, from Memory::Init, before any guest code
+// runs, and clears it again when the window is unmapped at exit.
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {  // in case a PC test compiles this file as C++
+#endif
+
+uint8_t* recomp_flat_guest_base;
+
+void spm_switch_set_flat_guest_base(uint8_t* base) {
+    recomp_flat_guest_base = base;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/switch/runtime/horizon_mbedtls.c b/switch/runtime/horizon_mbedtls.c
new file mode 100644
index 0000000..3f5f2d3
--- /dev/null
+++ b/switch/runtime/horizon_mbedtls.c
@@ -0,0 +1,47 @@
+// The Horizon pieces mbed TLS leaves to the platform; see switch/include/spm_mbedtls_config.h.
+#include <errno.h>
+#include <stddef.h>
+#include <sys/socket.h>
+
+#include <mbedtls/build_info.h>
+#include <mbedtls/net_sockets.h>
+#include <mbedtls/platform_time.h>
+#include <mbedtls/ssl.h>
+
+#include <switch.h>
+
+// Prototype from mbed TLS's library/entropy_poll.h (not an installed header).
+int mbedtls_hardware_poll(void* data, unsigned char* output, size_t len, size_t* olen);
+
+int mbedtls_hardware_poll(void* data, unsigned char* output, size_t len, size_t* olen)
+{
+    (void)data;
+    randomGet(output, len);
+    *olen = len;
+    return 0;
+}
+
+mbedtls_ms_time_t mbedtls_ms_time(void)
+{
+    return (mbedtls_ms_time_t)(armTicksToNs(armGetSystemTick()) / 1000000u);
+}
+
+// Same contract as net_sockets.c's version: bytes read, 0 at end of stream, or an mbed TLS error.
+int mbedtls_net_recv(void* ctx, unsigned char* buf, size_t len)
+{
+    const int fd = ((mbedtls_net_context*)ctx)->fd;
+    if (fd < 0) {
+        return MBEDTLS_ERR_NET_INVALID_CONTEXT;
+    }
+    const ssize_t ret = recv(fd, buf, len, 0);
+    if (ret >= 0) {
+        return (int)ret;
+    }
+    if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) {
+        return MBEDTLS_ERR_SSL_WANT_READ;
+    }
+    if (errno == EPIPE || errno == ECONNRESET) {
+        return MBEDTLS_ERR_NET_CONN_RESET;
+    }
+    return MBEDTLS_ERR_NET_RECV_FAILED;
+}
diff --git a/switch/runtime/horizon_mman.c b/switch/runtime/horizon_mman.c
new file mode 100644
index 0000000..125a2ee
--- /dev/null
+++ b/switch/runtime/horizon_mman.c
@@ -0,0 +1,91 @@
+// The Horizon side of switch/include/sys/mman.h; see that header for the scope.
+#include <sys/mman.h>
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <switch.h>
+
+#define HORIZON_PAGE_SIZE 0x1000u
+
+static size_t round_up_page(size_t length)
+{
+    return (length + HORIZON_PAGE_SIZE - 1u) & ~(size_t)(HORIZON_PAGE_SIZE - 1u);
+}
+
+static int is_page_aligned(const void* addr, size_t length)
+{
+    return ((uintptr_t)addr % HORIZON_PAGE_SIZE) == 0 && (length % HORIZON_PAGE_SIZE) == 0;
+}
+
+void* mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset)
+{
+    (void)offset;
+    // Only what HostContext asks for: a fresh anonymous private block anywhere.
+    if (addr != NULL || (flags & MAP_FIXED) || !(flags & MAP_ANONYMOUS) || (flags & MAP_SHARED) ||
+        fd != -1 || length == 0) {
+        errno = ENODEV;
+        return MAP_FAILED;
+    }
+    const size_t size = round_up_page(length);
+    void* block = aligned_alloc(HORIZON_PAGE_SIZE, size);
+    if (block == NULL) {
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    // POSIX anonymous mappings are zero-filled; the heap is not.
+    memset(block, 0, size);
+    if (prot != (PROT_READ | PROT_WRITE) && mprotect(block, size, prot) != 0) {
+        free(block);
+        return MAP_FAILED;
+    }
+    return block;
+}
+
+int munmap(void* addr, size_t length)
+{
+    if (addr == NULL || length == 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    // Give the allocator back ordinary read/write pages: a guard page left at PROT_NONE would fault
+    // the next owner of that memory.
+    mprotect(addr, round_up_page(length), PROT_READ | PROT_WRITE);
+    free(addr);
+    return 0;
+}
+
+int mprotect(void* addr, size_t length, int prot)
+{
+    if (!is_page_aligned(addr, length)) {
+        errno = EINVAL;
+        return -1;
+    }
+    // svcSetMemoryPermission takes none, R or RW on heap pages; executable heap is not a thing.
+    u32 perm;
+    if (prot & PROT_EXEC) {
+        errno = ENOTSUP;
+        return -1;
+    } else if (prot & PROT_WRITE) {
+        perm = Perm_Rw;
+    } else if (prot & PROT_READ) {
+        perm = Perm_R;
+    } else {
+        perm = Perm_None;
+    }
+    const Result rc = svcSetMemoryPermission(addr, length, perm);
+    if (R_FAILED(rc)) {
+        errno = EACCES;
+        return -1;
+    }
+    return 0;
+}
+
+// newlib declares getpagesize() but nothing in devkitA64's libc or libnx defines it; HostContext
+// sizes its guard page with it. Horizon's page size is fixed at 4 KiB.
+int getpagesize(void)
+{
+    return (int)HORIZON_PAGE_SIZE;
+}
