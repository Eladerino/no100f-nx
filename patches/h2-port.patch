+char* SDL_strstr(const char* haystack, const char* needle) { return strstr(haystack, needle); }
diff --git a/switch/source/debug_server.cpp b/switch/source/debug_server.cpp
new file mode 100644
index 0000000..96daba1
--- /dev/null
+++ b/switch/source/debug_server.cpp
@@ -0,0 +1,707 @@
+// Vendored into spm-nx from SwitchWakerHD (https://github.com/centollOS/SwitchWakerHD)
+// runtime/src/platform/debug_server.cpp at ac84576, unchanged below this block: the core is one
+// shared kit across the ports (keep it so). MPL-2.0 (licenses/MPL-2.0.txt); switch/THIRD_PARTY.md
+// has the entry. The spm-nx commands live in spm_debug_server.cpp.
+//
+// Debug server (debug_server.h): one listening thread, one thread per connection (at most kMaxConns; on the
+// Switch the listener joins them), the log's recent text in memory for "log" streams, the injected
+// controller state for the input poll.
+#include "debug_server.h"
+
+#include <arpa/inet.h>
+#include <dirent.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#ifdef __SWITCH__
+#include <pthread.h>
+#include <switch.h>
+#endif
+
+namespace debugsrv {
+namespace {
+
+Config g_cfg;
+std::atomic<bool> g_running{false};
+std::atomic<bool> g_keep{false};  // keep_log: the log's text is kept before start
+int g_listen = -1;
+// Socket-service ownership. This vendored copy deliberately diverges from
+// upstream SwitchWakerHD here: upstream assumes the core is the socket
+// service's sole owner, but spm-nx's scaffold pre-initialises sockets in
+// userAppInit (spm_switch_init.cpp), so start() may find the service already
+// up and only borrow it. g_ownsSockets is true only when this core's own
+// socketInitializeDefault() call succeeded; only then may it socketExit().
+// Do not drop this on an upstream re-sync.
+bool g_ownsSockets = false;
+
+struct Command {
+    std::string usage;
+    Handler handler;
+};
+std::mutex g_cmdMu;
+std::map<std::string, Command> g_cmds;
+
+// the log's most recent text: g_logBuf holds bytes [g_logBase, g_logBase + size) of everything logged since start
+std::mutex g_logMu;
+std::condition_variable g_logCv;
+std::string g_logBuf;
+uint64_t g_logBase = 0;
+constexpr size_t kLogKeep = 2u << 20;
+
+// open connection sockets (stop closes them)
+std::mutex g_sockMu;
+std::vector<int> g_sockets;
+std::atomic<int> g_conns{0};
+constexpr int kMaxConns = 4;
+
+void say(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void say(const char* fmt, ...) {
+    if (!g_cfg.log) return;
+    char line[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof line, fmt, ap);
+    va_end(ap);
+    g_cfg.log(line);
+}
+
+uint64_t now_ns() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+#ifdef __SWITCH__
+// libnx has no pthread_detach (core.cpp makes it a no-op): a detached thread keeps its stack and its
+// kernel thread for the rest of the session. That is fine for the listener, not for a thread per
+// connection (after ~60 connections the server stopped answering and the game hung). A connection
+// thread records itself here when it returns, and the listener joins it at its next accept.
+std::mutex g_doneMu;
+std::vector<pthread_t> g_done;
+
+void join_done() {
+    std::vector<pthread_t> done;
+    {
+        std::lock_guard<std::mutex> lk(g_doneMu);
+        done.swap(g_done);
+    }
+    for (pthread_t t : done) pthread_join(t, nullptr);
+}
+#endif
+
+// reap: the thread ends before the session does (a connection), so the listener joins it on the Switch
+void spawn(void (*fn)(void*), void* arg, bool reap = false) {
+#ifdef __SWITCH__
+    // Horizon commits a small default stack for std::thread
+    struct Start {
+        void (*fn)(void*);
+        void* arg;
+        bool reap;
+    };
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 128 << 10);
+    pthread_t t;
+    auto* s = new Start{fn, arg, reap};
+    if (pthread_create(&t, &attr, [](void* p) -> void* {
+            Start s = *static_cast<Start*>(p);
+            delete static_cast<Start*>(p);
+            s.fn(s.arg);
+            if (s.reap) {
+                std::lock_guard<std::mutex> lk(g_doneMu);
+                g_done.push_back(pthread_self());
+            }
+            return nullptr;
+        }, s) == 0) {
+        if (!reap) pthread_detach(t);
+    } else {
+        delete s;
+    }
+    pthread_attr_destroy(&attr);
+#else
+    (void)reap;
+    std::thread(fn, arg).detach();
+#endif
+}
+
+// ---------------------------------------------------------------- injected controller state
+std::mutex g_inMu;
+uint64_t g_until[16] = {};  // per button: 0 up, else held until this time (UINT64_MAX: until released)
+struct Stick {
+    float x = 0, y = 0;
+    uint64_t until = 0;
+};
+Stick g_sticks[2];
+
+const struct {
+    const char* name;
+    int bit;
+} kButtons[] = {
+    {"A", 0},      {"B", 1},     {"X", 2},      {"Y", 3},     {"LS", 4},     {"RS", 5},     {"L", 6},     {"R", 7},
+    {"ZL", 8},     {"ZR", 9},    {"PLUS", 10},  {"+", 10},    {"MINUS", 11}, {"-", 11},     {"LEFT", 12}, {"UP", 13},
+    {"RIGHT", 14}, {"DOWN", 15}, {"LSTICK", 4}, {"RSTICK", 5},
+};
+#ifdef __SWITCH__
+static_assert(HidNpadButton_A == 1 << 0 && HidNpadButton_StickL == 1 << 4 && HidNpadButton_ZL == 1 << 8 &&
+              HidNpadButton_Minus == 1 << 11 && HidNpadButton_Left == 1 << 12 && HidNpadButton_Down == 1 << 15);
+#endif
+
+// "A", "A+B", "zl", "+" -> bits; false on an unknown name
+bool parse_buttons(std::string s, uint32_t& bits) {
+    for (auto& ch : s) ch = char(toupper((unsigned char)ch));
+    auto one = [&](const std::string& name) {
+        for (auto& b : kButtons)
+            if (name == b.name) return bits |= 1u << b.bit, true;
+        return false;
+    };
+    if (s == "+" || s == "-") return one(s);
+    for (size_t start = 0;;) {
+        const size_t end = s.find('+', start);
+        if (!one(s.substr(start, end == std::string::npos ? std::string::npos : end - start))) return false;
+        if (end == std::string::npos) return true;
+        start = end + 1;
+    }
+}
+
+// the buttons of args (the last one may be a duration in ms)
+bool parse_press(const Args& a, uint32_t& bits, int& ms) {
+    bits = 0;
+    for (size_t i = 0; i < a.size(); i++) {
+        char* end;
+        long v = strtol(a[i].c_str(), &end, 10);
+        if (i + 1 == a.size() && i > 0 && *end == 0 && !a[i].empty()) {
+            ms = int(std::clamp(v, 1l, 60000l));
+            continue;
+        }
+        if (!parse_buttons(a[i], bits)) return false;
+    }
+    return bits != 0;
+}
+
+void wait_ms(int ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); }
+
+// ---------------------------------------------------------------- connections
+struct Conn {
+    int fd = -1;
+    std::string in;  // bytes received and not consumed yet
+};
+
+bool send_all(int fd, const void* data, size_t n) {
+    const char* p = static_cast<const char*>(data);
+    while (n) {
+#ifdef MSG_NOSIGNAL
+        ssize_t w = send(fd, p, n, MSG_NOSIGNAL);
+#else
+        ssize_t w = send(fd, p, n, 0);
+#endif
+        if (w <= 0) return false;
+        p += w;
+        n -= size_t(w);
+    }
+    return true;
+}
+bool send_header(int fd, bool ok, uint64_t n) {
+    char h[48];
+    int k = snprintf(h, sizeof h, "%s %llu\n", ok ? "ok" : "err", (unsigned long long)n);
+    return send_all(fd, h, size_t(k));
+}
+
+bool fill(Conn& c) {
+    char buf[16384];
+    ssize_t r = recv(c.fd, buf, sizeof buf, 0);
+    if (r <= 0) return false;
+    c.in.append(buf, size_t(r));
+    return true;
+}
+bool read_line(Conn& c, std::string& line) {
+    for (;;) {
+        size_t nl = c.in.find('\n');
+        if (nl != std::string::npos) {
+            line = c.in.substr(0, nl);
+            c.in.erase(0, nl + 1);
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            return true;
+        }
+        if (c.in.size() > 4096 || !fill(c)) return false;
+    }
+}
+
+Args split(const std::string& line) {
+    Args out;
+    size_t i = 0;
+    while (i < line.size()) {
+        while (i < line.size() && line[i] == ' ') i++;
+        if (i >= line.size()) break;
+        std::string a;
+        if (line[i] == '"') {
+            size_t e = line.find('"', i + 1);
+            if (e == std::string::npos) e = line.size();
+            a = line.substr(i + 1, e - i - 1);
+            i = e + 1;
+        } else {
+            size_t e = line.find(' ', i);
+            if (e == std::string::npos) e = line.size();
+            a = line.substr(i, e - i);
+            i = e;
+        }
+        out.push_back(std::move(a));
+    }
+    return out;
+}
+
+std::string resolve(const std::string& p) {
+    if (p.empty()) return g_cfg.root.empty() ? "." : g_cfg.root;
+    if (p[0] == '/' || p.find(':') != std::string::npos) return p;
+    return g_cfg.root.empty() ? p : g_cfg.root + "/" + p;
+}
+
+uint32_t crc32_update(uint32_t crc, const uint8_t* p, size_t n) {
+    static uint32_t table[256];
+    static const bool init = [] {
+        for (uint32_t i = 0; i < 256; i++) {
+            uint32_t c = i;
+            for (int k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            table[i] = c;
+        }
+        return true;
+    }();
+    (void)init;
+    crc = ~crc;
+    for (size_t i = 0; i < n; i++) crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
+    return ~crc;
+}
+
+bool send_reply(Conn& c, const Reply& r) {
+    if (r.file.empty()) return send_header(c.fd, r.ok, r.text.size()) && send_all(c.fd, r.text.data(), r.text.size());
+    FILE* f = fopen(r.file.c_str(), "rb");
+    if (!f) {
+        const std::string e = "cannot open " + r.file;
+        return send_header(c.fd, false, e.size()) && send_all(c.fd, e.data(), e.size());
+    }
+    struct stat st;
+    const uint64_t size = fstat(fileno(f), &st) == 0 ? uint64_t(st.st_size) : 0;
+    bool good = send_header(c.fd, true, size);
+    static thread_local std::vector<char> buf(256 << 10);
+    uint64_t left = size;
+    while (good && left) {
+        size_t n = fread(buf.data(), 1, std::min<uint64_t>(left, buf.size()), f);
+        if (!n) break;
+        good = send_all(c.fd, buf.data(), n);
+        left -= n;
+    }
+    fclose(f);
+    if (r.removeFile) remove(r.file.c_str());
+    return good && !left;
+}
+
+// "put <path> <size>": size bytes follow the line; written to <path>.part, then renamed over path
+Reply do_put(Conn& c, const Args& a) {
+    if (a.size() != 2) return err("usage: put <path> <size>");
+    const uint64_t size = strtoull(a[1].c_str(), nullptr, 10);
+    const std::string path = resolve(a[0]), part = path + ".part";
+    FILE* f = fopen(part.c_str(), "wb");
+    // the bytes are read either way, so the connection stays in step
+    uint64_t left = size;
+    uint32_t crc = 0;
+    bool wrote = f != nullptr;
+    if (f) setvbuf(f, nullptr, _IOFBF, 256 << 10);
+    while (left) {
+        if (c.in.empty() && !fill(c)) {
+            if (f) fclose(f), remove(part.c_str());
+            return err("connection closed during the upload");
+        }
+        const size_t n = size_t(std::min<uint64_t>(left, c.in.size()));
+        crc = crc32_update(crc, reinterpret_cast<const uint8_t*>(c.in.data()), n);
+        if (f && fwrite(c.in.data(), 1, n, f) != n) wrote = false;
+        c.in.erase(0, n);
+        left -= n;
+    }
+    if (!f) return err("cannot write " + part);
+    if (fclose(f) != 0) wrote = false;
+    if (!wrote) {
+        remove(part.c_str());
+        return err("write failed: " + part + " (SD card full?)");
+    }
+    remove(path.c_str());  // (FAT: rename does not replace)
+    if (rename(part.c_str(), path.c_str()) != 0) return err("cannot rename " + part + " to " + path);
+    char t[64];
+    snprintf(t, sizeof t, "crc32 %08x size %llu", crc, (unsigned long long)size);
+    say("[debug] put %s: %llu bytes", path.c_str(), (unsigned long long)size);
+    return ok(t);
+}
+
+Reply do_ls(const Args& a) {
+    const std::string path = resolve(a.empty() ? "" : a[0]);
+    DIR* d = opendir(path.c_str());
+    if (!d) return err("cannot open the folder " + path);
+    std::vector<std::string> lines;
+    while (dirent* e = readdir(d)) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        struct stat st;
+        const std::string full = path + "/" + e->d_name;
+        char l[400];
+        if (stat(full.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) snprintf(l, sizeof l, "d %12s %s", "-", e->d_name);
+        else
+            snprintf(l, sizeof l, "f %12llu %s", stat(full.c_str(), &st) == 0 ? (unsigned long long)st.st_size : 0ull,
+                     e->d_name);
+        lines.push_back(l);
+    }
+    closedir(d);
+    std::sort(lines.begin(), lines.end(), [](const std::string& x, const std::string& y) {
+        return x.compare(15, std::string::npos, y, 15, std::string::npos) < 0;
+    });
+    std::string out;
+    for (auto& l : lines) out += l + "\n";
+    return ok(out);
+}
+
+// "log [all]": the connection becomes a stream of the log's text (all: from the oldest text kept)
+void do_log(Conn& c, bool all) {
+    uint64_t pos;
+    {
+        std::lock_guard<std::mutex> lk(g_logMu);
+        pos = all ? g_logBase : g_logBase + g_logBuf.size();
+    }
+    if (!send_header(c.fd, true, 0)) return;
+    std::string chunk;
+    while (g_running.load()) {
+        {
+            std::unique_lock<std::mutex> lk(g_logMu);
+            g_logCv.wait_for(lk, std::chrono::milliseconds(500),
+                             [&] { return g_logBase + g_logBuf.size() > pos || !g_running.load(); });
+            chunk.clear();
+            if (pos < g_logBase) {
+                char note[96];
+                snprintf(note, sizeof note, "[debug] %llu bytes of log skipped (the stream fell behind)\n",
+                         (unsigned long long)(g_logBase - pos));
+                chunk = note;
+                pos = g_logBase;
+            }
+            chunk.append(g_logBuf, size_t(pos - g_logBase), std::string::npos);
+            pos = g_logBase + g_logBuf.size();
+        }
+        if (!chunk.empty() && !send_all(c.fd, chunk.data(), chunk.size())) return;
+        // the client closed the stream?
+        pollfd p{c.fd, POLLIN, 0};
+        if (poll(&p, 1, 0) > 0) {
+            char b[256];
+            if (recv(c.fd, b, sizeof b, 0) <= 0) return;
+        }
+    }
+}
+
+Reply builtin(Conn& c, const std::string& name, const Args& a, bool& handled) {
+    handled = true;
+    if (name == "ping") return ok("pong");
+    if (name == "help") {
+        std::string out =
+            "ping\nhelp\nlog [all]              the log as it is written (all: the last 2 MiB first)\n"
+            "logtext                the log text kept (the last 2 MiB)\n"
+            "get <path>\nput <path> <size>      then size bytes\nls [path]\nrm <path>\nmkdir <path>\n"
+            "press <buttons> [ms]   A B X Y L R ZL ZR PLUS MINUS UP DOWN LEFT RIGHT LS RS, A+B together; default 120 ms\n"
+            "hold <buttons>\nrelease [buttons]\nstick <L|R> <x> <y> [ms]   -1..1, y up; 0 0 lets go\n";
+        std::lock_guard<std::mutex> lk(g_cmdMu);
+        for (auto& [n, cmd] : g_cmds) out += cmd.usage + "\n";
+        return ok(out);
+    }
+    if (name == "logtext") {  // the log text kept (the running session's file cannot be opened while it is written)
+        std::lock_guard<std::mutex> lk(g_logMu);
+        if (!g_logBase) return ok(g_logBuf);
+        char note[96];
+        snprintf(note, sizeof note, "[debug] (the first %llu bytes of the log are not kept)\n", (unsigned long long)g_logBase);
+        return ok(note + g_logBuf);
+    }
+    if (name == "get") {
+        if (a.size() != 1) return err("usage: get <path>");
+        Reply r;
+        r.file = resolve(a[0]);
+        return r;
+    }
+    if (name == "put") return do_put(c, a);
+    if (name == "ls") return do_ls(a);
+    if (name == "rm") {
+        if (a.size() != 1) return err("usage: rm <path>");
+        const std::string p = resolve(a[0]);
+        return remove(p.c_str()) == 0 || rmdir(p.c_str()) == 0 ? ok() : err("cannot remove " + p);
+    }
+    if (name == "mkdir") {
+        if (a.size() != 1) return err("usage: mkdir <path>");
+        const std::string p = resolve(a[0]);
+        struct stat st;
+        return mkdir(p.c_str(), 0777) == 0 || (stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) ? ok()
+                                                                                                 : err("cannot create " + p);
+    }
+    if (name == "press" || name == "hold") {
+        uint32_t bits;
+        int ms = 120;
+        if (!parse_press(a, bits, ms)) return err("unknown button (A B X Y L R ZL ZR PLUS MINUS UP DOWN LEFT RIGHT LS RS)");
+        {
+            const uint64_t until = name == "hold" ? UINT64_MAX : now_ns() + uint64_t(ms) * 1000000;
+            std::lock_guard<std::mutex> lk(g_inMu);
+            for (int i = 0; i < 16; i++)
+                if (bits & (1u << i)) g_until[i] = until;
+        }
+        // a press replies once released and one game frame has seen it up, so presses in a row are separate
+        if (name == "press") wait_ms(ms + 50);
+        return ok();
+    }
+    if (name == "release") {
+        uint32_t bits = 0;
+        int unused = 0;
+        if (!a.empty() && !parse_press(a, bits, unused)) return err("unknown button");
+        std::lock_guard<std::mutex> lk(g_inMu);
+        for (int i = 0; i < 16; i++)
+            if (a.empty() || (bits & (1u << i))) g_until[i] = 0;
+        if (a.empty()) g_sticks[0].until = g_sticks[1].until = 0;
+        return ok();
+    }
+    if (name == "stick") {
+        if (a.size() < 3) return err("usage: stick <L|R> <x> <y> [ms]");
+        const int which = toupper((unsigned char)a[0][0]) == 'R' ? 1 : 0;
+        const float x = std::clamp(strtof(a[1].c_str(), nullptr), -1.0f, 1.0f);
+        const float y = std::clamp(strtof(a[2].c_str(), nullptr), -1.0f, 1.0f);
+        const int ms = a.size() > 3 ? atoi(a[3].c_str()) : 0;
+        {
+            std::lock_guard<std::mutex> lk(g_inMu);
+            Stick& s = g_sticks[which];
+            s.x = x, s.y = y;
+            s.until = x == 0 && y == 0 && !ms ? 0 : ms > 0 ? now_ns() + uint64_t(ms) * 1000000 : UINT64_MAX;
+        }
+        if (ms > 0) wait_ms(ms + 50);
+        return ok();
+    }
+    handled = false;
+    return {};
+}
+
+struct ConnStart {
+    int fd;
+};
+
+void connection(void* arg) {
+    Conn c;
+    c.fd = static_cast<ConnStart*>(arg)->fd;
+    delete static_cast<ConnStart*>(arg);
+    if (g_cfg.threadStart) g_cfg.threadStart();
+    std::string line;
+    while (g_running.load() && read_line(c, line)) {
+        Args a = split(line);
+        if (a.empty()) continue;
+        const std::string name = a[0];
+        a.erase(a.begin());
+        if (name == "log") {
+            do_log(c, !a.empty() && a[0] == "all");
+            break;
+        }
+        bool handled;
+        Reply r = builtin(c, name, a, handled);
+        if (!handled) {
+            Handler h;
+            {
+                std::lock_guard<std::mutex> lk(g_cmdMu);
+                auto it = g_cmds.find(name);
+                if (it != g_cmds.end()) h = it->second.handler;
+            }
+            r = h ? h(a) : err("unknown command " + name + " (help lists them)");
+        }
+        const bool sent = send_reply(c, r);
+        if (r.after) r.after();
+        if (!sent) break;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g_sockMu);
+        auto it = std::find(g_sockets.begin(), g_sockets.end(), c.fd);
+        if (it != g_sockets.end()) {
+            g_sockets.erase(it);
+            close(c.fd);
+        }
+    }
+    g_conns--;
+}
+
+// a socket listening on port (any address), or -1
+int open_listen(int port) {
+    const int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return -1;
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    addr.sin_port = htons(uint16_t(port));
+    if (bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof addr) != 0 || listen(fd, 4) != 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+void listener(void*) {
+    if (g_cfg.threadStart) g_cfg.threadStart();
+    int failures = 0;  // accept() failures in a row
+    while (g_running.load()) {
+        sockaddr_in from{};
+        socklen_t len = sizeof from;
+        const int fd = accept(g_listen, reinterpret_cast<sockaddr*>(&from), &len);
+#ifdef __SWITCH__
+        join_done();
+#endif
+        if (fd < 0) {
+            if (!g_running.load()) break;
+            // The Switch's sleep mode closes every socket, the listening one too: accept() then fails at once
+            // from the wake-up on. After a second of failures the listening socket is opened again.
+            if (++failures >= 10) {
+                if (g_listen >= 0) close(g_listen);
+                g_listen = open_listen(g_cfg.port);
+                say(g_listen >= 0 ? "[debug] listening again on port %d (the old socket stopped accepting, errno %d)"
+                                  : "[debug] cannot listen on port %d again yet (errno %d); retrying",
+                    g_cfg.port, errno);
+                failures = 0;
+            }
+            wait_ms(100);
+            continue;
+        }
+        failures = 0;
+        if (g_conns.load() >= kMaxConns) {
+            const char busy[] = "err 39\ntoo many connections (4 at most) open\n";
+            send_all(fd, busy, sizeof busy - 1);
+            close(fd);
+            continue;
+        }
+#ifdef SO_NOSIGPIPE
+        int one = 1;
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+        {
+            std::lock_guard<std::mutex> lk(g_sockMu);
+            g_sockets.push_back(fd);
+        }
+        g_conns++;
+        say("[debug] connection from %s", inet_ntoa(from.sin_addr));
+        spawn(connection, new ConnStart{fd}, true);
+    }
+}
+
+}  // namespace
+
+bool start(const Config& config) {
+    if (g_running.load()) return true;
+    g_cfg = config;
+#ifdef __SWITCH__
+    const Result rc = socketInitializeDefault();
+    if (R_SUCCEEDED(rc)) {
+        g_ownsSockets = true;
+    } else if (rc != MAKERESULT(Module_Libnx, LibnxError_AlreadyInitialized)) {
+        say("[debug] server off: socket service unavailable (rc 0x%x)", rc);
+        return false;
+    }
+    // AlreadyInitialized: the platform owns the socket service (see
+    // g_ownsSockets above); borrow it and continue to listen as normal.
+#endif
+    g_listen = open_listen(config.port);
+    if (g_listen < 0) {
+        say("[debug] server off: cannot listen on port %d", config.port);
+#ifdef __SWITCH__
+        if (g_ownsSockets) {
+            socketExit();
+            g_ownsSockets = false;
+        }
+#endif
+        return false;
+    }
+    g_running = true;
+    spawn(listener, nullptr);
+    return true;
+}
+
+bool running() { return g_running.load(std::memory_order_relaxed); }
+
+void add_command(const char* name, const char* usage, Handler handler) {
+    std::lock_guard<std::mutex> lk(g_cmdMu);
+    g_cmds[name] = {usage, std::move(handler)};
+}
+
+void log_tap(const char* data, size_t size) {
+    if ((!g_running.load(std::memory_order_relaxed) && !g_keep.load(std::memory_order_relaxed)) || !size) return;
+    {
+        std::lock_guard<std::mutex> lk(g_logMu);
+        g_logBuf.append(data, size);
+        if (g_logBuf.size() > kLogKeep) {
+            // keep the newest half, from a line start
+            size_t cut = g_logBuf.size() - kLogKeep / 2;
+            const size_t nl = g_logBuf.find('\n', cut);
+            if (nl != std::string::npos) cut = nl + 1;
+            g_logBuf.erase(0, cut);
+            g_logBase += cut;
+        }
+    }
+    g_logCv.notify_all();
+}
+
+void keep_log() { g_keep = true; }
+
+void drop_log() {
+    g_keep = false;
+    if (g_running.load()) return;
+    std::lock_guard<std::mutex> lk(g_logMu);
+    std::string().swap(g_logBuf);
+    g_logBase = 0;
+}
+
+void stop() {
+    if (!g_running.exchange(false)) return;
+    g_logCv.notify_all();
+    {
+        std::lock_guard<std::mutex> lk(g_sockMu);
+        for (int fd : g_sockets) {
+            shutdown(fd, SHUT_RDWR);
+            close(fd);
+        }
+        g_sockets.clear();
+    }
+    if (g_listen >= 0) {
+        shutdown(g_listen, SHUT_RDWR);
+        close(g_listen);
+        g_listen = -1;
+    }
+#ifdef __SWITCH__
+    if (g_ownsSockets) {
+        socketExit();
+        g_ownsSockets = false;
+    }
+#endif
+}
+
+Injected injected() {
+    Injected out;
+    const uint64_t now = now_ns();
+    std::lock_guard<std::mutex> lk(g_inMu);
+    for (int i = 0; i < 16; i++) {
+        if (g_until[i] && now >= g_until[i]) g_until[i] = 0;
+        if (g_until[i]) out.buttons |= 1ull << i;
+    }
+    for (int s = 0; s < 2; s++) {
+        Stick& st = g_sticks[s];
+        if (st.until && now >= st.until) st.until = 0;
+        if (st.until) out.stick[s] = true, out.x[s] = st.x, out.y[s] = st.y;
+    }
+    return out;
+}
+
+}  // namespace debugsrv
diff --git a/switch/source/debug_server.h b/switch/source/debug_server.h
new file mode 100644
index 0000000..3bbe9a8
--- /dev/null
+++ b/switch/source/debug_server.h
@@ -0,0 +1,80 @@
+// Vendored into spm-nx from SwitchWakerHD (https://github.com/centollOS/SwitchWakerHD)
+// runtime/src/platform/debug_server.h at ac84576, unchanged below this block except for the spm-nx
+// line in the port list further down: the core is one shared kit across the ports, so a fix lands
+// here once and is copied on, not forked per port. MPL-2.0 (licenses/MPL-2.0.txt);
+// switch/THIRD_PARTY.md has the entry. The spm-nx commands live in spm_debug_server.cpp.
+//
+// Debug server: a TCP port on the console for the development machine: the log as it is written, files on
+// the SD card (get, put, ls, rm), controller presses injected into the game's input, and the commands the
+// game adds (info, warp, screenshot, reload, quit). Off unless the settings menu turns it on (Debug, at the
+// next start); only for the local network: there is no password.
+//
+// This file and debug_server.cpp know nothing of the game and are the same in both ports (keep them so):
+//   SwitchWakerHD: runtime/src/platform/, commands in debug_switch.cpp, setting switchDebugServer, client
+//                  tools/switch/wwhd_debug.py, docs/debug-server.md
+//   SwitchWaker:   switch/native/source/, commands in cos_debug.cpp, setting COS_DEBUG_SERVER, client
+//                  scripts/switch/switchwaker_debug.py, docs/DEBUG_SERVER.md
+//   spm-nx:        switch/source/, commands in spm_debug_server.cpp, setting dkserver in
+//                  UserData/dk_diag.txt (boot-time only), no client yet (any TCP line client works)
+// They build on the Switch (libnx sockets) and on POSIX hosts (debug_server_host_test.cpp next to the client).
+//
+// Protocol: one command per line ("name arg arg ...", "double quotes" around an argument with spaces).
+// Every reply is "ok <n>\n" or "err <n>\n" followed by n bytes (text, or a file's contents). "put <path>
+// <size>" is followed by the file's size bytes. "log" turns the connection into a stream of the log's text
+// until the client closes it; "logtext" replies with the log text kept (the last 2 MiB: the running session's log
+// file cannot be read while the game writes it).
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace debugsrv {
+
+using Args = std::vector<std::string>;  // the command's arguments (its name not included)
+
+struct Reply {
+    bool ok = true;
+    std::string text;                 // the reply's bytes, unless file is set
+    std::string file;                 // send this file's contents instead
+    bool removeFile = false;          // remove file once sent (a screenshot)
+    std::function<void()> after;      // run once the reply is sent (quit, reload)
+};
+inline Reply ok(std::string text = {}) { return {true, std::move(text), {}, false, {}}; }
+inline Reply err(std::string text) { return {false, std::move(text), {}, false, {}}; }
+
+using Handler = std::function<Reply(const Args&)>;
+
+struct Config {
+    int port = 6543;
+    std::string root;                              // relative paths of get / put / ls / rm / mkdir
+    std::function<void(const char*)> log;          // a line for the game's log (no newline)
+    std::function<void()> threadStart;             // run first on each of the server's threads (priority, core)
+};
+
+// starts the listening thread (sockets initialised on the Switch); false when the port cannot be opened
+bool start(const Config& config);
+bool running();
+// commands the game adds; any thread, before or after start. Handlers run on the connection's thread.
+void add_command(const char* name, const char* usage, Handler handler);
+// the log's text as it is written (the game's log writer): kept for "log" streams; cheap while not running
+// and not keeping
+void log_tap(const char* data, size_t size);
+// keep the log's text before start (the first lines, written before the run options are read); drop_log
+// lets it go when the server will not start
+void keep_log();
+void drop_log();
+// closes the sockets (the Switch: and the socket service) before the program ends or restarts
+void stop();
+
+// ---- controller presses from "press", "hold", "release", "stick"
+// Buttons use libnx's HidNpadButton bits (A = bit 0 ... Down = bit 15) on every host.
+struct Injected {
+    uint64_t buttons = 0;  // held now
+    bool stick[2] = {};    // left, right: overridden now
+    float x[2] = {}, y[2] = {};  // -1..1, y up
+};
+Injected injected();  // the game's input poll, every time it reads the controller
+
+}  // namespace debugsrv
diff --git a/switch/source/fw_debug_server.cpp b/switch/source/fw_debug_server.cpp
new file mode 100644
index 0000000..7f4fc43
--- /dev/null
+++ b/switch/source/fw_debug_server.cpp
@@ -0,0 +1,237 @@
+// The FrightWorks commands for the shared debug server core (debug_server.h, vendored from
+// SwitchWakerHD through spm-nx: the core knows sockets, lines and files; this file is the part
+// that knows FrightWorks). Shaped after spm-nx's switch/source/spm_debug_server.cpp (12ec5e7).
+//
+// The gate is the build: FW_SWITCH_DEBUG_SERVER (switch/cmake/FrightWorksSwitch.cmake, on for dev
+// builds) makes userAppInit (fw_switch_init.cpp) call fw_debug_server_boot once the sockets are
+// up. Off, nothing here runs: no socket, no thread, no cost. A settings row comes later; H2 needs
+// the server from the first boot, before any menu exists.
+//
+// What the server adds over the core's built-ins (ping, help, get, put, ls, rm, mkdir, log,
+// logtext, press, hold, release, stick):
+//   info, uptime, flush, mark: enough for a scripted null-backend run to check the game is alive,
+//     bracket a test in the log and pull the log without a reboot;
+//   shot, warp, peek, poke, quit, reload answer err and say why: H2 has no renderer to capture,
+//     the level warp needs the dev menu's hook, guest reads need a mapping-checked read, and
+//     quit/reload need the hbloader next-load path. They are follow-ups.
+// Input injection needs no command here: the core holds the injected state and the provider at the
+// bottom of this file feeds it to the SDL gamepad shim's weak cos_switch_debug_input hook.
+//
+// The log feed: the runtime's log writer is stderr (redirected to UserData/Logs/stderr.log,
+// line-buffered). A pump thread tails that file from its start into log_tap, so the stream carries
+// the whole session, boot lines included, without touching the game's log call sites. The pump and
+// the core's threads run at the lowest thread priority (0x3B): a scripted run must never take time
+// from the game it is measuring.
+
+#include "debug_server.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
+
+extern "C" void fw_switch_keep_awake(bool on);
+
+namespace FwDebugServer {
+namespace {
+
+std::atomic<bool> g_booted{false};
+std::atomic<bool> g_pumpRun{false};
+std::thread g_pump;
+std::string g_root;  // the server's file root (Config.root), set at boot
+const auto g_bootTime = std::chrono::steady_clock::now();
+
+void LogLine(const char* line) {
+    std::fprintf(stderr, "%s\n", line);
+    std::fflush(stderr);
+}
+
+std::string Joined(const debugsrv::Args& a) {
+    std::string text;
+    for (size_t i = 0; i < a.size(); i++) {
+        if (i) text += ' ';
+        text += a[i];
+    }
+    return text;
+}
+
+long long UptimeSeconds() {
+    return std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - g_bootTime)
+        .count();
+}
+
+debugsrv::Reply CmdInfo(const debugsrv::Args&) {
+    char text[320];
+    std::snprintf(text, sizeof text,
+                  "game FrightWorks (GIHE78)\nbackend null (H2: no renderer)\nuptime %lld s\n"
+                  "server port 6543\nroot %s\n",
+                  UptimeSeconds(), g_root.c_str());
+    return debugsrv::ok(text);
+}
+
+debugsrv::Reply CmdUptime(const debugsrv::Args&) {
+    return debugsrv::ok(std::to_string(UptimeSeconds()) + "\n");
+}
+
+debugsrv::Reply CmdFlush(const debugsrv::Args&) {
+    std::fflush(stderr);
+    return debugsrv::ok();
+}
+
+debugsrv::Reply CmdMark(const debugsrv::Args& a) {
+    std::fprintf(stderr, "[server] mark \"%s\" at %lld s\n", Joined(a).c_str(), UptimeSeconds());
+    std::fflush(stderr);
+    return debugsrv::ok();
+}
+
+// ---- not in this build (the follow-ups, answered honestly) ------------------------------
+
+debugsrv::Reply CmdShot(const debugsrv::Args&) {
+    return debugsrv::err("shot is not in this build: H2 runs on Dawn's Null backend, so there is no frame to "
+                         "capture. It arrives with the deko3d present (H3)");
+}
+
+debugsrv::Reply CmdWarp(const debugsrv::Args&) {
+    return debugsrv::err("warp is not in this build: it needs a hook into the dev menu's level load. It is a "
+                         "follow-up");
+}
+
+debugsrv::Reply CmdPeek(const debugsrv::Args&) {
+    return debugsrv::err("peek is not in this build: the flat guest window faults on an unmapped read, so "
+                         "peeking first needs a mapping-checked read. It is a follow-up");
+}
+
+debugsrv::Reply CmdPoke(const debugsrv::Args&) {
+    return debugsrv::err("poke is not in this build (see peek)");
+}
+
+debugsrv::Reply CmdQuit(const debugsrv::Args&) {
+    return debugsrv::err("quit is not in this build: nothing yet ends the program on the server's word. It is a "
+                         "follow-up, with reload, through the hbloader next-load path");
+}
+
+debugsrv::Reply CmdReload(const debugsrv::Args&) {
+    return debugsrv::err("reload is not in this build: it needs the hbloader next-load path. It is a follow-up");
+}
+
+// ---- the log pump ------------------------------------------------------------------------
+
+void PumpMain() {
+#ifdef __SWITCH__
+    svcSetThreadPriority(CUR_THREAD_HANDLE, 0x3B);
+#endif
+    const std::string path = g_root + "/UserData/Logs/stderr.log";
+    std::vector<char> buf(64 << 10);
+    long offset = 0;
+    FILE* f = nullptr;
+    while (g_pumpRun.load()) {
+        if (!f) {
+            f = std::fopen(path.c_str(), "r");
+            offset = 0;
+        }
+        if (f) {
+            std::fflush(stderr);
+            if (std::fseek(f, 0, SEEK_END) == 0) {
+                const long size = std::ftell(f);
+                if (size < offset) offset = 0;  // the file was truncated: a new boot, start over
+                if (size > offset && std::fseek(f, offset, SEEK_SET) == 0) {
+                    long left = size - offset;
+                    while (left > 0 && g_pumpRun.load()) {
+                        const size_t want = size_t(std::min<long>(left, (long)buf.size()));
+                        const size_t got = std::fread(buf.data(), 1, want, f);
+                        if (!got) break;
+                        debugsrv::log_tap(buf.data(), got);
+                        offset += (long)got;
+                        left -= (long)got;
+                    }
+                }
+            }
+        }
+        // 100 ms between passes, in slices so stop() joins at once
+        for (int i = 0; i < 10 && g_pumpRun.load(); ++i)
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    if (f) std::fclose(f);
+}
+
+void ThreadStart() {
+#ifdef __SWITCH__
+    // The lowest priority: the server's threads only run in the game's gaps.
+    svcSetThreadPriority(CUR_THREAD_HANDLE, 0x3B);
+#endif
+}
+
+}  // namespace
+}  // namespace FwDebugServer
+
+extern "C" void fw_debug_server_boot(const char* root) {
+    using namespace FwDebugServer;
+    if (g_booted.exchange(true)) return;
+    g_root = root ? root : "";
+    // The pump replays the log file from its start, so the stream covers the boot too;
+    // keep_log covers the window between here and start().
+    debugsrv::keep_log();
+    debugsrv::add_command("info", "info                   game, backend, uptime, root", &CmdInfo);
+    debugsrv::add_command("uptime", "uptime                 seconds since the server booted", &CmdUptime);
+    debugsrv::add_command("flush", "flush                  flush stderr.log now", &CmdFlush);
+    debugsrv::add_command("mark", "mark <text>            a [server] mark line in the log, then a flush", &CmdMark);
+    debugsrv::add_command("shot", "shot                   not in this build (null backend)", &CmdShot);
+    debugsrv::add_command("warp", "warp <level>           not in this build", &CmdWarp);
+    debugsrv::add_command("peek", "peek <addr> [bytes]    not in this build", &CmdPeek);
+    debugsrv::add_command("poke", "poke <addr> <word>     not in this build", &CmdPoke);
+    debugsrv::add_command("quit", "quit                   not in this build", &CmdQuit);
+    debugsrv::add_command("reload", "reload                 not in this build", &CmdReload);
+
+    debugsrv::Config config;
+    config.port = 6543;
+    config.root = g_root;
+    config.log = &LogLine;
+    config.threadStart = &ThreadStart;
+    if (!debugsrv::start(config)) {
+        debugsrv::drop_log();
+        return;
+    }
+    LogLine("[server] debug server listening on port 6543: dev builds only, local network, NO password "
+            "(anyone who can reach the port can move files under the root and press buttons)");
+    fw_switch_keep_awake(true);
+    g_pumpRun = true;
+    g_pump = std::thread(&PumpMain);
+}
+
+extern "C" void fw_debug_server_stop(void) {
+    using namespace FwDebugServer;
+    if (!g_booted.load()) return;
+    g_pumpRun = false;
+    if (g_pump.joinable()) g_pump.join();
+    debugsrv::stop();
+    fw_switch_keep_awake(false);
+}
+
+#ifdef __SWITCH__
+// The SDL gamepad shim's input poll (switch/sdl3_shim/sdl3_shim_gamepad.c) calls this through a
+// weak declaration: the injected presses and sticks as if from the controller, and while the server
+// runs the controller counts as connected even with none attached. Keep it in this translation
+// unit: fw_debug_server_boot is what pulls the unit into the link, so the strong symbol is there for
+// the shim's weak call whenever the server code is.
+extern "C" int cos_switch_debug_input(uint64_t* buttons, int32_t sticks[4]) {
+    if (!debugsrv::running()) return 0;
+    const debugsrv::Injected in = debugsrv::injected();
+    *buttons |= in.buttons;
+    for (int s = 0; s < 2; s++) {
+        if (in.stick[s]) {
+            sticks[2 * s] = int32_t(in.x[s] * JOYSTICK_MAX);
+            sticks[2 * s + 1] = int32_t(in.y[s] * JOYSTICK_MAX);
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/switch/source/fw_switch_init.cpp b/switch/source/fw_switch_init.cpp
new file mode 100644
index 0000000..610574b
--- /dev/null
+++ b/switch/source/fw_switch_init.cpp
@@ -0,0 +1,418 @@
+// Adapted for FrightWorks from spm-nx switch/source/spm_switch_init.cpp (12ec5e7).
+// Process setup for the Switch NRO, outside the upstream runtime. libnx calls userAppInit() before
+// main() and userAppExit() after it returns, so the runtime's own main (runtime/src/main.cpp) runs
+// unchanged on top of what this file prepares:
+//   - the SD card layout: FW_SWITCH_ROOT (sdmc:/switch/<NRO name>/) holds the NRO, the game/ folder
+//     (the extracted disc) and UserData/ (settings, saves, caches, logs). The runtime finds both through the same environment
+//     variables its Android build uses (runtime/src/platform/host_platform.cpp);
+//   - stderr into UserData/Logs/stderr.log, because RT_LOG writes there and a log file is how a run
+//     on the console reports back;
+//   - BSD sockets (the debug server) when the network is up, and the debug server itself in dev
+//     builds (FW_SWITCH_DEBUG_SERVER);
+//   - a crash handler: a data abort or other exception writes its registers, the NRO's load address
+//     and a backtrace to UserData/Logs/crash.txt.
+#include <switch.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cinttypes>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <unwind.h>
+
+#include "guest_flat_memory.h"
+
+namespace {
+// Without the "sdmc:" prefix: fsdevMountSdmc makes the SD card the default device, so "/switch/..."
+// is the same place, and it is an absolute path to std::filesystem and sqlite. With the prefix both
+// treat the path as relative: std::filesystem::create_directories tries to make "sdmc:" and fails
+// (the NAND folders), and sqlite's unix VFS looks for "/sdmc:" (Aurora's caches).
+#ifndef FW_SWITCH_ROOT
+#error "FW_SWITCH_ROOT comes from switch/cmake/FrightWorksSwitch.cmake"
+#endif
+#ifndef FW_SWITCH_ELF_NAME
+#define FW_SWITCH_ELF_NAME "no100f-nx.elf"
+#endif
+constexpr const char* kRoot = FW_SWITCH_ROOT;
+constexpr const char* kUserData = FW_SWITCH_ROOT "/UserData";
+constexpr const char* kLogs = FW_SWITCH_ROOT "/UserData/Logs";
+constexpr const char* kStderrLog = FW_SWITCH_ROOT "/UserData/Logs/stderr.log";
+
+// The crash report goes to its own file through write(): through stderr it came out interleaved with,
+// and overwritten by, the other threads' log lines (boot 6).
+constexpr const char* kCrashLog = FW_SWITCH_ROOT "/UserData/Logs/crash.txt";
+
+bool g_sockets = false;
+u64 g_mainThreadId = 0;
+std::atomic<bool> g_crashing{false};
+std::atomic<u64> g_exitingThread{0};  // the thread in userAppExit(), which unmaps guest memory
+int g_crashFd = -1;
+char g_crashLine[512];
+
+void Say(const char* format, ...) {
+    if (g_crashFd < 0) {
+        return;
+    }
+    va_list args;
+    va_start(args, format);
+    int n = std::vsnprintf(g_crashLine, sizeof(g_crashLine), format, args);
+    va_end(args);
+    if (n <= 0) {
+        return;
+    }
+    if (n >= static_cast<int>(sizeof(g_crashLine))) {
+        n = sizeof(g_crashLine) - 1;
+    }
+    write(g_crashFd, g_crashLine, static_cast<size_t>(n));
+}
+
+const char* ExceptionName(u32 desc) {
+    switch (desc) {
+    case ThreadExceptionDesc_InstructionAbort: return "instruction abort";
+    case ThreadExceptionDesc_MisalignedPC: return "misaligned PC";
+    case ThreadExceptionDesc_MisalignedSP: return "misaligned SP";
+    case ThreadExceptionDesc_SError: return "SError";
+    case ThreadExceptionDesc_BadSVC: return "bad SVC";
+    case ThreadExceptionDesc_Trap: return "trap";
+    case ThreadExceptionDesc_Other: return "data abort or other";
+    default: return "unknown";
+    }
+}
+
+// The NRO's load address: the start of the code mapping this function is in.
+uintptr_t ImageBase() {
+    static uintptr_t base;
+    if (base == 0) {
+        MemoryInfo info{};
+        u32 page = 0;
+        if (R_SUCCEEDED(svcQueryMemory(&info, &page, reinterpret_cast<uintptr_t>(&ImageBase))) &&
+            info.type != MemType_Unmapped) {
+            base = info.addr;
+        }
+    }
+    return base;
+}
+
+// An address in the NRO also as an offset for addr2line.
+void SayAddress(const char* label, uint64_t address) {
+    const uintptr_t base = ImageBase();
+    if (base != 0 && address >= base && address - base < (1ull << 30)) {
+        Say("%s0x%016" PRIx64 " (" FW_SWITCH_ELF_NAME "+0x%" PRIx64 ")", label, address, address - base);
+    } else {
+        Say("%s0x%016" PRIx64, label, address);
+    }
+}
+
+bool ReadWord(uintptr_t address, uintptr_t* out) {
+    if (address == 0 || (address & 7) != 0) {
+        return false;
+    }
+    MemoryInfo info{};
+    u32 page = 0;
+    if (R_FAILED(svcQueryMemory(&info, &page, address)) || info.type == MemType_Unmapped ||
+        (info.perm & Perm_R) == 0 || address + 8 > info.addr + info.size) {
+        return false;
+    }
+    *out = *reinterpret_cast<const uintptr_t*>(address);
+    return true;
+}
+
+// The stack the frame pointer is in, and whether sp has left it: a stack overflow faults just below.
+void SayStack(uint64_t sp, uint64_t fp) {
+    MemoryInfo info{};
+    u32 page = 0;
+    if (fp == 0 || R_FAILED(svcQueryMemory(&info, &page, fp)) || info.type == MemType_Unmapped) {
+        return;
+    }
+    Say("  stack 0x%016" PRIx64 "-0x%016" PRIx64 " (%" PRIu64 " KiB, memory type 0x%" PRIx32 ")", info.addr,
+        info.addr + info.size, info.size / 1024, info.type);
+    if (sp < info.addr) {
+        Say(": sp is 0x%" PRIx64 " bytes below it, a stack overflow", info.addr - sp);
+    }
+    Say("\n");
+}
+
+void MakeDirectory(const char* path) {
+    if (mkdir(path, 0777) != 0 && errno != EEXIST) {
+        std::fprintf(stderr, "[switch] cannot create %s (errno %d)\n", path, errno);
+    }
+}
+} // namespace
+
+extern "C" {
+
+// runtime/horizon_tls.c: the thread pointer clang's thread_locals use (TPIDR_EL0) for this thread.
+void spm_switch_tls_init_main_thread(void);
+void spm_switch_tls_check_main_thread(void);
+// runtime/guest_flat_memory_horizon.cpp: unmaps the flat guest window, which hbloader needs gone.
+void spm_switch_guest_memory_release(void);
+// source/fw_debug_server.cpp: starts the debug server (dev builds, FW_SWITCH_DEBUG_SERVER), and
+// stops it so its threads are gone before the socket service closes below. Stop is inert when the
+// server never started.
+void fw_debug_server_boot(const char* root);
+void fw_debug_server_stop(void);
+// switch/sdl3_shim/sdl3_shim_events.c: queues the SDL quit the frame loop turns into the
+// normal shutdown (ExitForAuroraWindowClose -> userAppExit). Safe from any thread, once.
+void sdl3_shim_request_quit(void);
+
+// The exception handler runs on its own stack: the faulting thread's may be the problem.
+alignas(16) u8 __nx_exception_stack[0x4000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+
+// Applet status changes, delivered by libnx's message processing (appletProcessMessage, reached
+// from the frame loop's pump or the watcher thread below): the exit request asks the frame loop to
+// quit. It only exists because userAppInit locks exit (appletLockExit); without the lock a HOME >
+// Close ends the process outright and nothing of ours runs. With it, Close resumes the process with
+// ExitRequest and gives it 15 s to exit before a forced kill.
+void fw_switch_applet_status_hook(AppletHookType type, void* /*param*/) {
+    if (type == AppletHookType_OnExitRequest) {
+        // One line per exit so a log shows the applet close went through the
+        // lock instead of a forced kill (a kill leaves no line at all).
+        std::fprintf(stderr, "[switch] exit request received (HOME close)\n");
+        sdl3_shim_request_quit();
+    }
+}
+
+// The second applet-message consumer. The frame loop's pump (through the SDL
+// shim) runs only while frames advance, and after a close the process is
+// resumed out of focus, where nothing guarantees the frame loop keeps
+// presenting. The watcher makes sure the ExitRequest is acted on either way.
+// libnx tolerates two consumers: whichever thread receives a message runs it
+// through the one processing routine (the loser's receive returns "no message").
+// The receive is non-blocking; the thread sleeps between empty polls.
+void fw_switch_applet_watcher(void) {
+    for (;;) {
+        u32 msg = 0;
+        if (R_SUCCEEDED(appletGetMessage(&msg))) {
+            appletProcessMessage(msg);
+        } else {
+            svcSleepThread(100000000ULL);  // 100 ms
+        }
+    }
+}
+
+AppletHookCookie g_appletHookCookie;
+
+void userAppInit(void) {
+    // Before anything that could touch a thread_local: libnx runs the static constructors after this.
+    spm_switch_tls_init_main_thread();
+    MakeDirectory(kRoot);
+    MakeDirectory(kUserData);
+    MakeDirectory(kLogs);
+    if (std::freopen(kStderrLog, "w", stderr) != nullptr) {
+        std::setvbuf(stderr, nullptr, _IOLBF, 0);  // line-buffered: a crash keeps the last lines
+    }
+    spm_switch_tls_check_main_thread();
+    setenv("WIICOMPILED_RUNTIME_DIR", kRoot, 1);
+    setenv("WIICOMPILED_DATA_DIR", kUserData, 1);
+
+    g_sockets = R_SUCCEEDED(socketInitializeDefault());
+    svcGetThreadId(&g_mainThreadId, CUR_THREAD_HANDLE);
+    ImageBase();
+
+    // Lock exit, so a close from the HOME menu arrives as an ExitRequest (with
+    // 15 s to act on it) instead of the system ending the process with nothing
+    // of ours run: the frame loop then shuts down through userAppExit, which unlocks again at its end.
+    // libnx itself never locks. A game that is hung when the player closes it
+    // now takes up to those 15 s to be killed.
+    const Result lockRc = appletLockExit();
+
+    // Registered before main() so no status change of the run can precede it.
+    appletHook(&g_appletHookCookie, fw_switch_applet_status_hook, nullptr);
+    std::thread(fw_switch_applet_watcher).detach();
+
+    AppletType type = appletGetAppletType();
+    std::fprintf(stderr, "[switch] FrightWorks starting: %s, %s mode, sockets %s\n",
+                 type == AppletType_Application || type == AppletType_SystemApplication
+                     ? "title takeover"
+                     : "applet mode (little memory: launch through a game instead)",
+                 appletGetOperationMode() == AppletOperationMode_Console ? "docked" : "handheld",
+                 g_sockets ? "up" : "off");
+    if (R_FAILED(lockRc))
+        std::fprintf(stderr, "[switch] appletLockExit failed (rc 0x%x): a HOME close will skip shutdown\n", lockRc);
+#if FW_SWITCH_DEBUG_SERVER
+    if (g_sockets) {
+        fw_debug_server_boot(kRoot);
+    } else {
+        std::fprintf(stderr, "[switch] debug server not started: sockets are off\n");
+    }
+#endif
+}
+
+// The debug server keeps the console awake while it runs: a console under test is left alone for
+// minutes at a time.
+void fw_switch_keep_awake(bool on) {
+    appletSetAutoSleepDisabled(on);
+}
+
+void userAppExit(void) {
+    // After main() and the static destructors. A thread still running (the fatal exit leaves
+    // Aurora's alive) may touch guest memory once it is unmapped; the crash handler parks it.
+    u64 self = 0;
+    svcGetThreadId(&self, CUR_THREAD_HANDLE);
+    g_exitingThread = self;
+    std::fprintf(stderr, "[switch] userAppExit: shutting down\n");
+    // The debug server stops first: its threads touch nothing the release unmaps, but they
+    // hold the listening socket the socketExit below is about to close under them.
+    fw_debug_server_stop();
+    spm_switch_guest_memory_release();
+    std::fprintf(stderr, "[switch] userAppExit: clean shutdown done\n");
+    std::fflush(stderr);
+    if (g_sockets) {
+        socketExit();
+    }
+    // Last: libnx requires the exit lock (userAppInit) to be released before
+    // the process ends, and appletExit runs right after this function returns.
+    appletUnlockExit();
+}
+
+void __libnx_exception_handler(ThreadExceptionDump* ctx) {
+    u64 threadId = 0;
+    svcGetThreadId(&threadId, CUR_THREAD_HANDLE);
+    // During exit, another thread's fault is one that outlived the unmapped guest memory, not a
+    // crash worth a report over the one that may have caused the exit: it waits, like a second
+    // crash does. The exiting thread's own fault is still reported.
+    const u64 exiting = g_exitingThread;
+    bool expected = false;
+    if ((exiting != 0 && exiting != threadId) || !g_crashing.compare_exchange_strong(expected, true)) {
+        for (;;) {  // a second thread's exception waits for the first report to end the process
+            svcSleepThread(1000000000ULL);
+        }
+    }
+    g_crashFd = open(kCrashLog, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+
+    Say("[switch] CRASH: %s (0x%" PRIx32 ") esr=0x%" PRIx32 " far=0x%016" PRIx64 " on thread %" PRIu64 "%s\n",
+        ExceptionName(ctx->error_desc), ctx->error_desc, ctx->esr, ctx->far.x, threadId,
+        threadId == g_mainThreadId ? " (the main thread: guest scheduler)" : " (not the main thread)");
+    const uint64_t flatBase = reinterpret_cast<uint64_t>(RECOMP_FLAT_GUEST_BASE);
+    if (flatBase != 0 && ctx->far.x >= flatBase && ctx->far.x - flatBase < GuestFlat::kGuestSpaceSize) {
+        Say("  -> guest address 0x%08" PRIx64 " through the flat window, where nothing is mapped: a wild "
+            "guest pointer or an MMIO read (the window has no page traps)\n",
+            ctx->far.x - flatBase);
+    }
+    SayAddress("  pc=", ctx->pc.x);
+    SayAddress(" lr=", ctx->lr.x);
+    Say(" sp=0x%016" PRIx64 " fp=0x%016" PRIx64 "\n", ctx->sp.x, ctx->fp.x);
+    SayStack(ctx->sp.x, ctx->fp.x);
+    for (int i = 0; i < 29; i += 4) {
+        Say(" ");
+        for (int j = i; j < i + 4 && j < 29; ++j) {
+            Say(" x%-2d=0x%016" PRIx64, j, ctx->cpu_gprs[j].x);
+        }
+        Say("\n");
+    }
+    Say("  image base=0x%016" PRIxPTR ": aarch64-none-elf-addr2line -f -C -i -e " FW_SWITCH_ELF_NAME " <offset>\n",
+        ImageBase());
+    Say("  backtrace (pc, lr, then the frame records' call sites):\n");
+    SayAddress("    #0 ", ctx->pc.x);
+    Say("\n");
+    SayAddress("    #1 ", ctx->lr.x);
+    Say("\n");
+    uintptr_t fp = ctx->fp.x;
+    for (int depth = 2; fp != 0 && depth < 48; ++depth) {
+        uintptr_t next = 0;
+        uintptr_t ret = 0;
+        if (!ReadWord(fp, &next) || !ReadWord(fp + 8, &ret) || ret == 0) {
+            break;
+        }
+        char label[16];
+        std::snprintf(label, sizeof(label), "    #%d ", depth);
+        SayAddress(label, ret - 4);
+        Say("\n");
+        if (next <= fp) {
+            break;
+        }
+        fp = next;
+    }
+    if (g_crashFd >= 0) {
+        close(g_crashFd);
+    }
+    std::_Exit(EXIT_FAILURE);
+}
+
+// The host stack for the runtime's fatal paths (runtime/src/main.cpp FormatHostStackTrace), which
+// has no walker on this platform: a std::terminate() reported only the guest's state (boot 7). The
+// unwind tables first (C++ code has them), the frame records if they give out early. Offsets are
+// for aarch64-none-elf-addr2line -f -C -i -e the NRO's ELF.
+namespace {
+struct UnwindFrames {
+    uintptr_t pcs[48];
+    unsigned count = 0;
+    unsigned skip = 0;
+};
+
+_Unwind_Reason_Code CollectFrame(_Unwind_Context* context, void* argument) {
+    auto* frames = static_cast<UnwindFrames*>(argument);
+    const uintptr_t pc = _Unwind_GetIP(context);
+    if (pc == 0) {
+        return _URC_END_OF_STACK;
+    }
+    if (frames->skip > 0) {
+        --frames->skip;
+        return _URC_NO_REASON;
+    }
+    frames->pcs[frames->count++] = pc;
+    return frames->count < 48 ? _URC_NO_REASON : _URC_END_OF_STACK;
+}
+} // namespace
+
+size_t fw_switch_host_backtrace(char* out, size_t size, unsigned skip) {
+    if (out == nullptr || size == 0) {
+        return 0;
+    }
+    UnwindFrames frames;
+    frames.skip = skip + 1;  // this function
+    _Unwind_Backtrace(CollectFrame, &frames);
+    const char* method = "unwind tables";
+    if (frames.count < 3) {
+        frames.count = 0;
+        method = "frame records";
+        uintptr_t fp = reinterpret_cast<uintptr_t>(__builtin_frame_address(0));
+        while (fp != 0 && frames.count < 48) {
+            uintptr_t next = 0;
+            uintptr_t ret = 0;
+            if (!ReadWord(fp, &next) || !ReadWord(fp + 8, &ret) || ret == 0) {
+                break;
+            }
+            frames.pcs[frames.count++] = ret;
+            if (next <= fp) {
+                break;
+            }
+            fp = next;
+        }
+    }
+
+    u64 threadId = 0;
+    svcGetThreadId(&threadId, CUR_THREAD_HANDLE);
+    const uintptr_t base = ImageBase();
+    size_t used = 0;
+    auto append = [&](const char* format, auto... args) {
+        if (used + 1 >= size) {
+            return;
+        }
+        const int n = std::snprintf(out + used, size - used, format, args...);
+        if (n > 0) {
+            used += static_cast<size_t>(n) < size - used ? static_cast<size_t>(n) : size - used - 1;
+        }
+    };
+    append("[switch] host stack on thread %" PRIu64 "%s (%s; image base 0x%" PRIxPTR
+           ", aarch64-none-elf-addr2line -f -C -i -e " FW_SWITCH_ELF_NAME " <offset>):\n",
+           threadId, threadId == g_mainThreadId ? " (main)" : "", method, base);
+    for (unsigned i = 0; i < frames.count; ++i) {
+        // Return addresses: the call is the instruction before each.
+        const uintptr_t pc = frames.pcs[i] - 4;
+        if (base != 0 && pc >= base && pc - base < (1ull << 30)) {
+            append("[switch]   #%u " FW_SWITCH_ELF_NAME "+0x%" PRIxPTR "\n", i, pc - base);
+        } else {
+            append("[switch]   #%u 0x%016" PRIxPTR "\n", i, pc);
+        }
+    }
+    return used;
+}
+
+} // extern "C"
