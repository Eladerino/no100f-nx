+    file(READ "${DAWN_SYSTEM_UTILS_SOURCE}" DAWN_SYSTEM_UTILS_TEXT)
+    if(NOT DAWN_SYSTEM_UTILS_TEXT MATCHES "DAWN_PLATFORM_IS\\(SWITCH\\)")
+        execute_process(
