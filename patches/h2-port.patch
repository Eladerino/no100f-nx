diff --git a/switch/include/spm_switch_compat.h b/switch/include/spm_switch_compat.h
new file mode 100644
index 0000000..3816984
--- /dev/null
+++ b/switch/include/spm_switch_compat.h
@@ -0,0 +1,33 @@
+// spm_switch_compat.h - force-included into every runtime and translated TU on the Switch build
+// (switch/cmake/SpmSwitch.cmake). It fills the gaps between Horizon's newlib/libnx and the POSIX
+// surface the runtime assumes, so the upstream sources compile without per-file edits.
+#pragma once
+
+#ifdef __SWITCH__
+
+#include <setjmp.h>
+#include <stdint.h>
+
+// Horizon has no signals, so there is no signal mask for sigsetjmp to save. The runtime only uses
+// the sig- pair so a POSIX SIGSEGV handler can longjmp out without leaving SIGSEGV blocked
+// (system_bridge.h); with no signals, plain setjmp/longjmp is exactly equivalent.
+#ifndef _SIGJMP_BUF_DEFINED
+#define _SIGJMP_BUF_DEFINED
+typedef jmp_buf sigjmp_buf;
+#endif
+#ifndef sigsetjmp
+#define sigsetjmp(env, savemask) setjmp(env)
+#endif
+#ifndef siglongjmp
+#define siglongjmp(env, val) longjmp(env, val)
+#endif
+
+// libnx's BSD socket headers omit the address-string length constants.
+#ifndef INET_ADDRSTRLEN
+#define INET_ADDRSTRLEN 16
+#endif
+#ifndef INET6_ADDRSTRLEN
+#define INET6_ADDRSTRLEN 46
+#endif
+
+#endif // __SWITCH__
diff --git a/switch/include/spm_worker_blocked.h b/switch/include/spm_worker_blocked.h
new file mode 100644
index 0000000..2ef95f7
--- /dev/null
+++ b/switch/include/spm_worker_blocked.h
@@ -0,0 +1,47 @@
+// Measurement only: time the GX worker thread spends blocked inside its replay on the renderer
+// (Aurora's decode thread and frame worker, deko's locks, fences and shader builds), reported per
+// frame by a [gxworker] line. Scopes on any other thread cost one call and record nothing. Weak so
+// that targets without the runtime's GX worker still link.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+enum SpmWorkerBlockedSite : uint32_t {
+    kSpmBlockedDecodeQueue = 0,  // Aurora's decode queue full
+    kSpmBlockedDecodeSync,       // waiting for the decode thread to finish (copies, syncs)
+    kSpmBlockedFrameWorker,      // waiting on a frame worker phase
+    kSpmBlockedStagingMap,       // waiting for the staging buffer map
+    kSpmBlockedQueueLock,        // contending for deko's queue mutex
+    kSpmBlockedGpuFence,         // waiting for the GPU
+    kSpmBlockedShader,           // waiting for a shader build
+    kSpmBlockedSiteCount,
+};
+
+extern "C" bool spm_gxworker_is_current_thread() noexcept __attribute__((weak));
+extern "C" void spm_gxworker_note_blocked(uint32_t site, uint64_t micros) noexcept __attribute__((weak));
+
+class SpmWorkerBlockedScope {
+public:
+    explicit SpmWorkerBlockedScope(SpmWorkerBlockedSite site) noexcept
+        : site_(site), active_(spm_gxworker_is_current_thread != nullptr && spm_gxworker_is_current_thread()) {
+        if (active_) {
+            start_ = std::chrono::steady_clock::now();
+        }
+    }
+    ~SpmWorkerBlockedScope() {
+        if (active_) {
+            spm_gxworker_note_blocked(
+                site_, static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                                 std::chrono::steady_clock::now() - start_)
+                                                 .count()));
+        }
+    }
+    SpmWorkerBlockedScope(const SpmWorkerBlockedScope&) = delete;
+    SpmWorkerBlockedScope& operator=(const SpmWorkerBlockedScope&) = delete;
+
+private:
+    SpmWorkerBlockedSite site_;
+    bool active_;
+    std::chrono::steady_clock::time_point start_{};
+};
diff --git a/switch/include/sys/mman.h b/switch/include/sys/mman.h
new file mode 100644
index 0000000..1b6869c
--- /dev/null
+++ b/switch/include/sys/mman.h
@@ -0,0 +1,38 @@
+// sys/mman.h for Horizon (Switch build only; switch/include is on the include path before newlib's).
+//
+// Horizon has no mmap. The runtime's only remaining user on the Switch is HostContext
+// (runtime/src/host_context.cpp), which maps a fiber stack and protects its lowest page as a guard.
+// So this covers exactly that: anonymous private mappings, backed by page-aligned heap memory, and
+// mprotect on page-aligned heap ranges through svcSetMemoryPermission. A file-backed or shared
+// mapping fails with ENODEV instead of pretending to work. Guest memory does not come through here;
+// it has its own Horizon file (switch/runtime/guest_flat_memory_horizon.cpp).
+#pragma once
+
+#include <stddef.h>
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PROT_NONE 0x0
+#define PROT_READ 0x1
+#define PROT_WRITE 0x2
+#define PROT_EXEC 0x4
+
+#define MAP_SHARED 0x01
+#define MAP_PRIVATE 0x02
+#define MAP_FIXED 0x10
+#define MAP_ANONYMOUS 0x20
+#define MAP_ANON MAP_ANONYMOUS
+#define MAP_NORESERVE 0x4000
+
+#define MAP_FAILED ((void*)-1)
+
+void* mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset);
+int munmap(void* addr, size_t length);
+int mprotect(void* addr, size_t length, int prot);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/switch/include/sys/un.h b/switch/include/sys/un.h
new file mode 100644
index 0000000..b30a10b
--- /dev/null
+++ b/switch/include/sys/un.h
@@ -0,0 +1,12 @@
+// sys/un.h for Horizon (Switch build only). libnx's BSD sockets define AF_UNIX but ship no
+// sockaddr_un, because Horizon's socket service has no local sockets. The one user is Discord Rich
+// Presence (runtime/src/discord_presence.cpp), which looks for a Discord client's IPC socket; on the
+// Switch its connect() fails like it does on a PC with Discord closed, and presence stays off.
+#pragma once
+
+#include <sys/socket.h>
+
+struct sockaddr_un {
+    sa_family_t sun_family;
+    char sun_path[108];
+};
